@implements IAsyncDisposable

<div class="ls-app-shell ls-filter-window" data-theme="@Settings.GetThemeKey()">
    <div class="ls-filter-win-shell">
        <!-- 顶部规则操作栏 -->
        <header class="ls-filter-win-header">
            <div class="ls-filter-win-title-group">
                <h2>搜索与过滤</h2>
                <span class="ls-filter-win-count ls-mono">
                    @if (_matchedEntries.Count > 0 && _activeMatchIndex >= 0)
                    {
                        <span><strong>@(_activeMatchIndex + 1)</strong> / @_matchedEntries.Count 命中（共 @SessionHub.EntryCount 条）</span>
                    }
                    else
                    {
                        <span>命中 <strong>@_matchedEntries.Count</strong> / @SessionHub.EntryCount 条</span>
                    }
                </span>

                <div class="ls-jump-group" role="group" aria-label="跳转命中项">
                    <button type="button"
                            class="ls-icon-btn ls-icon-btn-sm"
                            title="跳转到上一条命中并在主窗口定位"
                            aria-label="上一条命中"
                            disabled="@(_matchedEntries.Count == 0)"
                            @onclick="JumpPrevMatchAsync">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="18 15 12 9 6 15" />
                        </svg>
                    </button>
                    <button type="button"
                            class="ls-icon-btn ls-icon-btn-sm"
                            title="跳转到下一条命中并在主窗口定位"
                            aria-label="下一条命中"
                            disabled="@(_matchedEntries.Count == 0)"
                            @onclick="JumpNextMatchAsync">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="ls-filter-win-actions">
                <button type="button"
                        class="ls-btn-subtle is-accent"
                        @onclick="AddEmptyRule">
                    + 新增规则
                </button>
                <button type="button"
                        class="ls-btn-subtle"
                        disabled="@(_matchedEntries.Count == 0)"
                        @onclick="CopyAllMatchedAsync">
                    复制命中
                </button>
                <button type="button"
                        class="ls-btn-subtle"
                        disabled="@(_rules.Count == 0)"
                        @onclick="SessionHub.ClearRules">
                    清空规则
                </button>
            </div>
        </header>

        <!-- 可直接原地编辑的多条过滤规则列表 -->
        <section class="ls-filter-rules-area" aria-label="过滤规则列表">
            @if (_rules.Count == 0)
            {
                <div class="ls-rules-empty">
                    点击右上角「+ 新增规则」，支持多条关键词 / 正则同时过滤并在主窗口同步着色。
                </div>
            }
            else
            {
                @foreach (var rule in _rules)
                {
                    var hasError = !string.IsNullOrEmpty(rule.Pattern)
                        && !TerminalFilterEngine.TryValidateRule(rule.Pattern, rule.IsRegex, rule.MatchCase, out var ruleError);
                    var errorText = !string.IsNullOrEmpty(rule.Pattern)
                        && !TerminalFilterEngine.TryValidateRule(rule.Pattern, rule.IsRegex, rule.MatchCase, out var err)
                        ? err
                        : null;

                    <div class="ls-rule-editor-row @(rule.IsEnabled ? string.Empty : "is-disabled")">
                        <label class="ls-switch ls-switch-sm" title="@(rule.IsEnabled ? "已启用" : "已暂停")">
                            <input type="checkbox"
                                   checked="@rule.IsEnabled"
                                   @onchange="e => OnRuleEnabledChanged(rule.Id, e)" />
                            <span class="ls-switch-track"></span>
                        </label>

                        <button type="button"
                                class="ls-color-dot ls-color-@rule.ColorKey"
                                title="点击切换高亮颜色"
                                @onclick="() => CycleRuleColor(rule.Id)"></button>

                        <div class="ls-rule-input-wrap">
                            <input class="ls-input ls-rule-edit-input ls-mono @(hasError ? "is-invalid" : string.Empty)"
                                   type="text"
                                   placeholder="@(rule.IsRegex ? "输入正则表达式，如 ERROR|temp=\\d+ ..." : "输入要匹配的关键词...")"
                                   value="@rule.Pattern"
                                   @oninput="e => OnRulePatternInput(rule.Id, e)" />
                            @if (errorText is not null)
                            {
                                <span class="ls-rule-inline-error">@errorText</span>
                            }
                        </div>

                        <button type="button"
                                class="ls-pill-toggle @(rule.IsRegex ? "is-active" : string.Empty)"
                                title="正则表达式模式"
                                @onclick="() => ToggleRuleRegex(rule.Id)">
                            .*
                        </button>

                        <button type="button"
                                class="ls-pill-toggle @(rule.MatchCase ? "is-active" : string.Empty)"
                                title="区分大小写"
                                @onclick="() => ToggleRuleCase(rule.Id)">
                            Aa
                        </button>

                        <button type="button"
                                class="ls-icon-btn"
                                title="删除该规则"
                                aria-label="删除规则"
                                @onclick="() => SessionHub.RemoveRule(rule.Id)">
                            ×
                        </button>
                    </div>
                }
            }
        </section>

        <!-- 独立过滤结果展示区 -->
        <section class="ls-filter-results-stage" aria-label="过滤命中结果">
            <div class="ls-terminal-viewport ls-mono"
                 tabindex="0"
                 style="font-size: @(Settings.Serial.FontSizePx)px;"
                 @ref="_viewportRef">
                @if (SessionHub.CompiledRules.Count == 0)
                {
                    <div class="ls-empty-state">
                        <div class="ls-empty-title">暂无启用的过滤规则</div>
                        <p class="ls-empty-hint">在上方输入关键词或正则后，命中的日志会实时显示在这里，主窗口同步彩色高亮。</p>
                    </div>
                }
                else if (_matchedEntries.Count == 0)
                {
                    <div class="ls-empty-state">
                        <div class="ls-empty-title">没有命中的日志</div>
                        <p class="ls-empty-hint">调整上方规则条件或等待新数据到达。</p>
                    </div>
                }
                else
                {
                    @for (var i = 0; i < _matchedEntries.Count; i++)
                    {
                        var index = i;
                        var entry = _matchedEntries[i];
                        var isFocused = index == _activeMatchIndex;
                        <div class="ls-log-row @GetRowCssClass(entry) @(ReferenceEquals(_copiedEntry, entry) ? "is-copied" : string.Empty) @(isFocused ? "is-jump-target" : string.Empty)"
                             data-entry-id="@entry.EntryId"
                             title="单击在主窗口定位上下文 · 双击复制整条"
                             @onclick="() => FocusMatchAsync(index)"
                             @ondblclick="() => CopyEntryAsync(entry)">
                            @if (Settings.Serial.ShowTimestamp)
                            {
                                <span class="ls-log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                            }
                            @if (Settings.Serial.ShowDirection)
                            {
                                <span class="ls-log-dir @GetDirCssClass(entry)">@entry.Direction</span>
                            }
                            @if (Settings.Serial.ShowPayload)
                            {
                                <span class="ls-log-body">@RenderHighlightedText(TerminalSessionHub.FormatEntryText(entry, Settings.Serial.DisplayMode))</span>
                            }
                        </div>
                    }
                }
            </div>

            @if (_copyToastText is not null)
            {
                <div class="ls-copy-toast" role="status">@_copyToastText</div>
            }
        </section>
    </div>
</div>

@code {
    [Inject]
    private WorkbenchSettings Settings { get; set; } = default!;

    [Inject]
    private TerminalSessionHub SessionHub { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private ElementReference _viewportRef;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _scrollWatcher;
    private DotNetObjectReference<FilterWindowRoot>? _dotNetRef;

    private IReadOnlyList<TerminalFilterRule> _rules = [];
    private List<TerminalLogEntry> _matchedEntries = [];
    private int _activeMatchIndex = -1;
    private TerminalLogEntry? _copiedEntry;
    private string? _copyToastText;
    private int _copyToastVersion;
    private bool _userScrolledUp;
    private bool _pendingScrollToBottom;
    private bool _disposed;

    protected override void OnInitialized()
    {
        // 初次打开窗口且没有规则时，默认自动添一条空白规则，打开就能直接打字。
        if (SessionHub.GetRulesSnapshot().Count == 0)
        {
            SessionHub.AddRule();
        }

        Settings.Changed += HandleExternalChange;
        SessionHub.EntriesChanged += HandleEntriesChanged;
        SessionHub.RulesChanged += HandleExternalChange;
        RefreshViewData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/LinkStudio.UI/js/workbench.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                _scrollWatcher = await _jsModule.InvokeAsync<IJSObjectReference?>(
                    "attachAutoScrollWatcher", _viewportRef, _dotNetRef);
            }
            catch (Exception error)
            {
                Serilog.Log.Warning(error, "初始化过滤窗口交互脚本失败");
            }
        }

        if (_pendingScrollToBottom && Settings.Serial.AutoScroll && !_userScrolledUp && _jsModule is not null)
        {
            _pendingScrollToBottom = false;
            try
            {
                await _jsModule.InvokeVoidAsync("scrollToBottom", _viewportRef);
            }
            catch (JSDisconnectedException)
            {
                // 窗口关闭时忽略脚本调用异常。
            }
        }
    }

    [JSInvokable]
    public void OnTerminalScrollPositionChanged(bool isNearBottom)
    {
        if (!_disposed)
        {
            _userScrolledUp = !isNearBottom;
        }
    }

    private void HandleEntriesChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            var prevCount = _matchedEntries.Count;
            RefreshViewData();
            if (_matchedEntries.Count > prevCount && Settings.Serial.AutoScroll && !_userScrolledUp)
            {
                _pendingScrollToBottom = true;
            }

            StateHasChanged();
        });
    }

    private void HandleExternalChange()
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            RefreshViewData();
            StateHasChanged();
        });
    }

    private void RefreshViewData()
    {
        _rules = SessionHub.GetRulesSnapshot();
        var compiled = SessionHub.CompiledRules;
        if (compiled.Count == 0)
        {
            _matchedEntries = [];
            return;
        }

        var entries = SessionHub.GetEntriesSnapshot();
        var matched = new List<TerminalLogEntry>();
        foreach (var entry in entries)
        {
            var text = TerminalSessionHub.FormatEntryText(entry, Settings.Serial.DisplayMode);
            if (TerminalFilterEngine.IsMatch(text, compiled))
            {
                matched.Add(entry);
            }
        }

        _matchedEntries = matched;
        if (_matchedEntries.Count == 0)
        {
            _activeMatchIndex = -1;
        }
        else if (_activeMatchIndex >= _matchedEntries.Count)
        {
            _activeMatchIndex = _matchedEntries.Count - 1;
        }
    }

    private Task JumpPrevMatchAsync()
    {
        if (_matchedEntries.Count == 0)
        {
            return Task.CompletedTask;
        }

        var nextIndex = _activeMatchIndex <= 0
            ? _matchedEntries.Count - 1
            : _activeMatchIndex - 1;
        return FocusMatchAsync(nextIndex);
    }

    private Task JumpNextMatchAsync()
    {
        if (_matchedEntries.Count == 0)
        {
            return Task.CompletedTask;
        }

        var nextIndex = (_activeMatchIndex + 1) % _matchedEntries.Count;
        return FocusMatchAsync(nextIndex);
    }

    private async Task FocusMatchAsync(int index)
    {
        if (index < 0 || index >= _matchedEntries.Count)
        {
            return;
        }

        _activeMatchIndex = index;
        var entry = _matchedEntries[index];

        // 通知主窗口同步定位并高亮该条目，方便查看上下文。
        SessionHub.RequestJumpToEntry(entry.EntryId);

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("scrollToEntry", _viewportRef, entry.EntryId);
            }
            catch (JSDisconnectedException)
            {
                // 窗口关闭时忽略脚本调用异常。
            }
        }
    }

    private void AddEmptyRule()
    {
        SessionHub.AddRule();
    }

    private void OnRulePatternInput(Guid id, ChangeEventArgs e)
    {
        var pattern = e.Value?.ToString() ?? string.Empty;
        SessionHub.UpdateRule(id, r => r.Pattern = pattern);
    }

    private void OnRuleEnabledChanged(Guid id, ChangeEventArgs e)
    {
        if (e.Value is bool enabled)
        {
            SessionHub.UpdateRule(id, r => r.IsEnabled = enabled);
        }
    }

    private void ToggleRuleRegex(Guid id)
    {
        SessionHub.UpdateRule(id, r => r.IsRegex = !r.IsRegex);
    }

    private void ToggleRuleCase(Guid id)
    {
        SessionHub.UpdateRule(id, r => r.MatchCase = !r.MatchCase);
    }

    private void CycleRuleColor(Guid id)
    {
        SessionHub.UpdateRule(id, r =>
        {
            var idx = Array.IndexOf(TerminalSessionHub.FilterColors, r.ColorKey);
            r.ColorKey = TerminalSessionHub.FilterColors[(idx + 1) % TerminalSessionHub.FilterColors.Length];
        });
    }

    private async Task CopyEntryAsync(TerminalLogEntry entry)
    {
        if (_jsModule is null)
        {
            return;
        }

        var line = TerminalSessionHub.BuildCopyLine(entry, Settings.Serial);
        if (string.IsNullOrEmpty(line))
        {
            return;
        }

        try
        {
            var copied = await _jsModule.InvokeAsync<bool>("copyTextToClipboard", line, true);
            if (copied)
            {
                await ShowCopyToastAsync(entry, "已复制该条");
            }
        }
        catch (JSDisconnectedException)
        {
            // 窗口关闭时忽略脚本调用异常。
        }
    }

    private async Task CopyAllMatchedAsync()
    {
        if (_jsModule is null || _matchedEntries.Count == 0)
        {
            return;
        }

        var lines = _matchedEntries
            .Select(e => TerminalSessionHub.BuildCopyLine(e, Settings.Serial))
            .Where(l => !string.IsNullOrEmpty(l));
        var content = string.Join(Environment.NewLine, lines);
        if (string.IsNullOrEmpty(content))
        {
            return;
        }

        try
        {
            var copied = await _jsModule.InvokeAsync<bool>("copyTextToClipboard", content, false);
            if (copied)
            {
                await ShowCopyToastAsync(null, $"已复制 {_matchedEntries.Count} 条命中日志");
            }
        }
        catch (JSDisconnectedException)
        {
            // 窗口关闭时忽略脚本调用异常。
        }
    }

    private async Task ShowCopyToastAsync(TerminalLogEntry? entry, string text)
    {
        var version = ++_copyToastVersion;
        _copiedEntry = entry;
        _copyToastText = text;
        StateHasChanged();

        if (entry is not null)
        {
            await Task.Delay(320);
            if (!_disposed && _copyToastVersion == version)
            {
                _copiedEntry = null;
                StateHasChanged();
            }

            await Task.Delay(980);
        }
        else
        {
            await Task.Delay(1300);
        }

        if (!_disposed && _copyToastVersion == version)
        {
            _copyToastText = null;
            StateHasChanged();
        }
    }

    private RenderFragment RenderHighlightedText(string text) => builder =>
    {
        var compiled = SessionHub.CompiledRules;
        if (compiled.Count == 0 || string.IsNullOrEmpty(text))
        {
            builder.AddContent(0, text);
            return;
        }

        var segments = TerminalFilterEngine.BuildSegments(text, compiled);
        var seq = 0;
        foreach (var segment in segments)
        {
            if (segment.ColorKey is null)
            {
                builder.AddContent(seq++, segment.Text);
            }
            else
            {
                builder.OpenElement(seq++, "mark");
                builder.AddAttribute(seq++, "class", $"ls-hl ls-hl-{segment.ColorKey}");
                builder.AddContent(seq++, segment.Text);
                builder.CloseElement();
            }
        }
    };

    private static string GetRowCssClass(TerminalLogEntry entry) => entry.Direction switch
    {
        "TX" => "is-tx",
        "SYS" => "is-sys",
        _ => "is-rx"
    };

    private static string GetDirCssClass(TerminalLogEntry entry) => entry.Direction switch
    {
        "TX" => "ls-dir-tx",
        "SYS" => "ls-dir-sys",
        _ => "ls-dir-rx"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Settings.Changed -= HandleExternalChange;
        SessionHub.EntriesChanged -= HandleEntriesChanged;
        SessionHub.RulesChanged -= HandleExternalChange;

        if (_scrollWatcher is not null)
        {
            try
            {
                await _scrollWatcher.InvokeVoidAsync("dispose");
                await _scrollWatcher.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 窗口关闭时无需释放前端监听器。
            }
        }

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 窗口关闭时无需释放前端模块。
            }
        }

        _dotNetRef?.Dispose();
    }
}
