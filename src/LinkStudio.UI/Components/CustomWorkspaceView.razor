@using LinkStudio.Core.Workspaces
@implements IAsyncDisposable

<div class="ls-custom-ws-page">
    <!-- 顶部栏：画板名称、连接态、添加组件、编辑/运行切换、导出与删除 -->
    <header class="ls-topbar">
        <div class="ls-topbar-group">
            @if (_isEditing)
            {
                <input class="ls-input ls-ws-title-input"
                       type="text"
                       aria-label="画板名称"
                       value="@Workspace.Name"
                       @oninput="OnTitleInputAsync" />
            }
            else
            {
                <h2 class="ls-ws-title">@Workspace.Name</h2>
            }

            <span class="ls-status-pill @(SessionHub.IsDeviceOpen ? "is-connected" : string.Empty)">
                <span class="ls-status-pill-dot"></span>
                @(SessionHub.IsDeviceOpen ? SessionHub.ActiveDeviceName : "未连接")
            </span>
        </div>

        <div class="ls-topbar-group ls-topbar-right">
            <!-- 添加组件下拉菜单 -->
            <div class="ls-ws-add-wrap">
                <button type="button"
                        class="ls-btn-subtle is-accent"
                        @onclick="() => _isAddMenuOpen = !_isAddMenuOpen">
                    + 添加组件
                </button>

                @if (_isAddMenuOpen)
                {
                    <div class="ls-menu-backdrop" @onclick="() => _isAddMenuOpen = false"></div>
                    <div class="ls-ws-add-menu" role="menu" aria-label="选择要添加的组件">
                        <button type="button" class="ls-combobox-option" @onclick="() => AddWidgetAsync(WidgetKind.Waveform)">
                            <span>实时波形图</span>
                            <span class="ls-suggest-val">整行</span>
                        </button>
                        <button type="button" class="ls-combobox-option" @onclick="() => AddWidgetAsync(WidgetKind.KpiCard)">
                            <span>数据指标组</span>
                            <span class="ls-suggest-val">多字段小格</span>
                        </button>
                        <button type="button" class="ls-combobox-option" @onclick="() => AddWidgetAsync(WidgetKind.Skyplot)">
                            <span>GNSS 天空图</span>
                            <span class="ls-suggest-val">半宽</span>
                        </button>
                        <button type="button" class="ls-combobox-option" @onclick="() => AddWidgetAsync(WidgetKind.SatelliteSnr)">
                            <span>卫星载噪比</span>
                            <span class="ls-suggest-val">半宽</span>
                        </button>
                        <button type="button" class="ls-combobox-option" @onclick="() => AddWidgetAsync(WidgetKind.FieldTable)">
                            <span>实时字段表</span>
                            <span class="ls-suggest-val">半宽</span>
                        </button>
                    </div>
                }
            </div>

            <button type="button"
                    class="ls-pill-toggle @(_isEditing ? "is-active" : string.Empty)"
                    @onclick="() => _isEditing = !_isEditing">
                @(_isEditing ? "完成编辑" : "编辑布局")
            </button>

            <button type="button"
                    class="ls-btn-subtle"
                    title="复制当前画板的 .linkworkspace JSON 配置到剪贴板"
                    @onclick="ExportToClipboardAsync">
                @(_exportToast ?? "导出")
            </button>

            @if (_isEditing)
            {
                <button type="button"
                        class="ls-btn-subtle ls-btn-danger"
                        title="删除该自定义画板"
                        @onclick="() => OnDeleteWorkspace.InvokeAsync(Workspace.Id)">
                    删除画板
                </button>
            }
        </div>
    </header>

    <div class="ls-custom-ws-body">
        @if (Workspace.Widgets.Count == 0)
        {
            <div class="ls-ws-empty">
                <div class="ls-empty-title">空白画板已就绪</div>
                <p class="ls-empty-hint">
                    自由组合下方组件来搭建你的专属调试工具，所有布局与字段绑定都会自动保存为 <code>.linkworkspace</code> 文件。
                </p>
                <div class="ls-quick-add-row">
                    <button type="button" class="ls-quick-add-btn" @onclick="() => AddWidgetAsync(WidgetKind.Waveform)">+ 实时波形图</button>
                    <button type="button" class="ls-quick-add-btn" @onclick="() => AddWidgetAsync(WidgetKind.KpiCard)">+ 数据指标组</button>
                    <button type="button" class="ls-quick-add-btn" @onclick="() => AddWidgetAsync(WidgetKind.Skyplot)">+ GNSS 天空图</button>
                    <button type="button" class="ls-quick-add-btn" @onclick="() => AddWidgetAsync(WidgetKind.SatelliteSnr)">+ 卫星载噪比</button>
                    <button type="button" class="ls-quick-add-btn" @onclick="() => AddWidgetAsync(WidgetKind.FieldTable)">+ 实时字段表</button>
                </div>
            </div>
        }
        else
        {
            <div class="ls-canvas-grid" @ref="_gridRef">
                @for (var idx = 0; idx < Workspace.Widgets.Count; idx++)
                {
                    var widget = Workspace.Widgets[idx];
                    var widgetIndex = idx;
                    var span = Math.Clamp(widget.ColSpan, 3, 12);

                    <div class="ls-canvas-cell @(_isEditing ? "is-editing" : string.Empty)"
                         data-widget-id="@widget.Id"
                         style="grid-column: span @span;">
                        @if (_isEditing)
                        {
                            <div class="ls-cell-toolbar" data-drag-handle="true" title="按住此处拖动调整组件顺序">
                                <span class="ls-drag-grip" aria-hidden="true">⋮⋮</span>
                                <input class="ls-cell-title-input"
                                       type="text"
                                       placeholder="组件标题"
                                       value="@widget.Title"
                                       @oninput="e => OnWidgetTitleChangedAsync(widget, e)" />

                                <div class="ls-cell-actions">
                                    <div class="ls-span-group ls-mono" role="group" aria-label="组件宽度">
                                        @foreach (var opt in _spanOptions)
                                        {
                                            var colVal = opt.Cols;
                                            <button type="button"
                                                    class="ls-span-btn @(widget.ColSpan == colVal ? "is-active" : string.Empty)"
                                                    @onclick="() => SetWidgetSpanAsync(widget, colVal)">
                                                @opt.Label
                                            </button>
                                        }
                                    </div>

                                    <button type="button"
                                            class="ls-icon-btn ls-icon-btn-sm"
                                            title="向前移动"
                                            disabled="@(widgetIndex == 0)"
                                            @onclick="() => MoveWidgetAsync(widgetIndex, -1)">
                                        ←
                                    </button>
                                    <button type="button"
                                            class="ls-icon-btn ls-icon-btn-sm"
                                            title="向后移动"
                                            disabled="@(widgetIndex == Workspace.Widgets.Count - 1)"
                                            @onclick="() => MoveWidgetAsync(widgetIndex, 1)">
                                        →
                                    </button>
                                    <button type="button"
                                            class="ls-icon-btn ls-icon-btn-sm ls-btn-danger-icon"
                                            title="移除该组件"
                                            @onclick="() => RemoveWidgetAsync(widget.Id)">
                                        ×
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="ls-cell-content">
                            @switch (widget.Type)
                            {
                                case WidgetKind.Waveform:
                                    var state = GetOrCreateWaveState(widget.Id);
                                    <WaveformChartWidget AllSeries="_allSeries"
                                                         PinnedKeys="widget.BoundFields"
                                                         HiddenKeys="state.HiddenKeys"
                                                         ViewStart="state.ViewStart"
                                                         ViewEnd="state.ViewEnd"
                                                         OnViewRangeChanged="r => OnWidgetRangeChanged(widget.Id, r)"
                                                         OnAddKey="k => AddWidgetFieldAsync(widget, k)"
                                                         OnRemoveKey="k => RemoveWidgetFieldAsync(widget, k)"
                                                         OnToggleVisibility="k => ToggleWidgetFieldVisibility(widget.Id, k)" />
                                    break;

                                case WidgetKind.KpiCard:
                                    var kpiDraft = GetKpiDraft(widget.Id);
                                    var isKpiSuggestOpen = string.Equals(_activeKpiSuggestWidgetId, widget.Id, StringComparison.Ordinal);
                                    var kpiSuggestions = isKpiSuggestOpen ? GetKpiSuggestions(widget, kpiDraft) : [];
                                    <section class="ls-widget-card ls-kpi-group-widget" aria-label="@widget.Title">
                                        @if (_isEditing || widget.BoundFields.Count == 0)
                                        {
                                            <div class="ls-kpi-group-adder">
                                                <div class="ls-kpi-bind-row">
                                                    <input class="ls-input ls-kpi-bind-input ls-mono"
                                                           type="text"
                                                           placeholder="搜索或输入字段名添加到指标组，如 imu.ax / temp"
                                                           value="@kpiDraft"
                                                           @onfocus="() => OpenKpiSuggest(widget.Id)"
                                                           @oninput="e => OnKpiDraftInput(widget.Id, e)"
                                                           @onkeydown="e => OnKpiInputKeyDownAsync(widget, e)" />

                                                    @if (isKpiSuggestOpen && kpiSuggestions.Count > 0)
                                                    {
                                                        <div class="ls-menu-backdrop" @onclick="CloseKpiSuggest"></div>
                                                        <div class="ls-field-suggest-menu ls-mono" role="listbox" aria-label="可用数值字段建议">
                                                            @foreach (var item in kpiSuggestions)
                                                            {
                                                                var suggestKey = item.Key;
                                                                <button type="button"
                                                                        class="ls-combobox-option"
                                                                        @onclick="() => AddKpiSuggestionAsync(widget, suggestKey)">
                                                                    <span>@item.Key</span>
                                                                    <span class="ls-suggest-val">@item.Latest.ToString("F2")@item.Unit</span>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                <button type="button"
                                                        class="ls-btn-subtle is-accent"
                                                        disabled="@string.IsNullOrWhiteSpace(kpiDraft)"
                                                        @onclick="() => AddKpiDraftAsync(widget)">
                                                    + 添加
                                                </button>
                                            </div>
                                        }

                                        @if (widget.BoundFields.Count == 0)
                                        {
                                            <div class="ls-kpi-group-empty">
                                                <span class="ls-empty-hint">点击上方输入框添加 1 个或多个数值指标（自动以紧凑小格平铺）</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ls-kpi-group-tiles">
                                                @for (var fIdx = 0; fIdx < widget.BoundFields.Count; fIdx++)
                                                {
                                                    var key = widget.BoundFields[fIdx];
                                                    var color = WaveformChartWidget.Palette[fIdx % WaveformChartWidget.Palette.Length];
                                                    var kpiSeries = _allSeries.FirstOrDefault(s => string.Equals(s.Key, key, StringComparison.Ordinal));
                                                    <div class="ls-kpi-tile-shell">
                                                        @if (_isEditing)
                                                        {
                                                            <button type="button"
                                                                    class="ls-kpi-tile-remove"
                                                                    title="移除 @key"
                                                                    aria-label="移除 @key"
                                                                    @onclick="() => RemoveWidgetFieldAsync(widget, key)">
                                                                ×
                                                            </button>
                                                        }

                                                        @if (kpiSeries is not null)
                                                        {
                                                            <KpiCardWidget Series="kpiSeries" AccentColor="@color" />
                                                        }
                                                        else
                                                        {
                                                            <article class="ls-kpi-card" style="--ls-kpi-accent: @color;">
                                                                <div class="ls-kpi-top">
                                                                    <span class="ls-kpi-dot"></span>
                                                                    <span class="ls-kpi-key ls-mono">@key</span>
                                                                </div>
                                                                <div class="ls-kpi-waiting ls-mono">等待数据…</div>
                                                            </article>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </section>
                                    break;

                                case WidgetKind.Skyplot:
                                    <SkyplotWidget Satellites="_gnss.Satellites" />
                                    break;

                                case WidgetKind.SatelliteSnr:
                                    <SatelliteSnrWidget Satellites="_gnss.Satellites"
                                                        Title="@(string.IsNullOrWhiteSpace(widget.Title) ? "卫星载噪比（SNR dB-Hz）" : widget.Title)" />
                                    break;

                                case WidgetKind.FieldTable:
                                    <FieldTableWidget Title="@(string.IsNullOrWhiteSpace(widget.Title) ? "实时字段表" : widget.Title)"
                                                      Fields="_fields"
                                                      Filter="@widget.FieldFilter"
                                                      FilterChanged="f => OnFieldFilterChangedAsync(widget, f)" />
                                    break;
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly (int Cols, string Label)[] _spanOptions =
    [
        (4, "1/3"),
        (6, "1/2"),
        (8, "2/3"),
        (12, "整行")
    ];

    private sealed class WaveRuntimeState
    {
        public HashSet<string> HiddenKeys { get; } = new(StringComparer.Ordinal);
        public double ViewStart { get; set; } = 0.0;
        public double ViewEnd { get; set; } = 1.0;
    }

    [Inject]
    private TerminalSessionHub SessionHub { get; set; } = default!;

    [Inject]
    private IWorkspaceStore WorkspaceStore { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Parameter, EditorRequired]
    public WorkspaceDocument Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback OnWorkspaceMutated { get; set; }

    [Parameter]
    public EventCallback<string> OnDeleteWorkspace { get; set; }

    private readonly Dictionary<string, WaveRuntimeState> _waveStates = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _kpiDrafts = new(StringComparer.Ordinal);
    private IReadOnlyList<NumericSeriesSnapshot> _allSeries = [];
    private IReadOnlyList<LiveFieldState> _fields = [];
    private GnssSummarySnapshot _gnss = new();
    private bool _isEditing;
    private bool _isAddMenuOpen;
    private string? _activeKpiSuggestWidgetId;
    private string? _exportToast;
    private string? _lastWorkspaceId;
    private Timer? _refreshThrottleTimer;
    private int _refreshScheduled;

    private ElementReference _gridRef;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _dragHandle;
    private DotNetObjectReference<CustomWorkspaceView>? _dotNetRef;
    private bool _dragAttached;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _refreshThrottleTimer = new Timer(OnThrottleElapsed, null, Timeout.Infinite, Timeout.Infinite);
        SessionHub.ProtocolDataChanged += HandleDataChanged;
        SessionHub.ConnectionStateChanged += HandleDataChanged;
        ReloadSnapshots();
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastWorkspaceId, Workspace.Id, StringComparison.Ordinal))
        {
            _lastWorkspaceId = Workspace.Id;
            _isAddMenuOpen = false;
            _activeKpiSuggestWidgetId = null;
            // 空白画板默认进入编辑态，方便用户直接添组件；已有组件的画板默认进入干净运行态。
            _isEditing = Workspace.Widgets.Count == 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var hasGrid = Workspace.Widgets.Count > 0;
        if (hasGrid && !_dragAttached && !_disposed)
        {
            try
            {
                _jsModule ??= await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/LinkStudio.UI/js/workbench.js");
                _dotNetRef ??= DotNetObjectReference.Create(this);
                _dragHandle = await _jsModule.InvokeAsync<IJSObjectReference?>(
                    "attachCanvasDragReorder", _gridRef, _dotNetRef);
                _dragAttached = _dragHandle is not null;
            }
            catch (Exception error)
            {
                Serilog.Log.Warning(error, "初始化画板组件拖拽排序失败");
            }
        }
        else if (!hasGrid && _dragAttached)
        {
            await DetachDragAsync();
        }
    }

    [JSInvokable]
    public async Task OnWidgetReordered(string sourceId, string targetId)
    {
        if (_disposed || !_isEditing || string.Equals(sourceId, targetId, StringComparison.Ordinal))
        {
            return;
        }

        var sourceIndex = Workspace.Widgets.FindIndex(w => string.Equals(w.Id, sourceId, StringComparison.Ordinal));
        var targetIndex = Workspace.Widgets.FindIndex(w => string.Equals(w.Id, targetId, StringComparison.Ordinal));
        if (sourceIndex < 0 || targetIndex < 0)
        {
            return;
        }

        var moved = Workspace.Widgets[sourceIndex];
        Workspace.Widgets.RemoveAt(sourceIndex);
        Workspace.Widgets.Insert(targetIndex, moved);
        await OnWorkspaceMutated.InvokeAsync();
        StateHasChanged();
    }

    private void HandleDataChanged()
    {
        if (_disposed)
        {
            return;
        }

        if (Interlocked.CompareExchange(ref _refreshScheduled, 1, 0) == 0)
        {
            _refreshThrottleTimer?.Change(100, Timeout.Infinite);
        }
    }

    private void OnThrottleElapsed(object? state)
    {
        Interlocked.Exchange(ref _refreshScheduled, 0);
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            ReloadSnapshots();
            StateHasChanged();
        });
    }

    private void ReloadSnapshots()
    {
        _allSeries = SessionHub.GetNumericSeriesSnapshot();
        _fields = SessionHub.GetLiveFieldsSnapshot();
        _gnss = SessionHub.GetGnssSnapshot();
    }

    private WaveRuntimeState GetOrCreateWaveState(string widgetId)
    {
        if (!_waveStates.TryGetValue(widgetId, out var state))
        {
            state = new WaveRuntimeState();
            _waveStates[widgetId] = state;
        }

        return state;
    }

    private async Task OnTitleInputAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(text))
        {
            Workspace.Name = text.Trim();
            await OnWorkspaceMutated.InvokeAsync();
        }
    }

    private async Task AddWidgetAsync(WidgetKind kind)
    {
        _isAddMenuOpen = false;
        Workspace.Widgets.Add(WidgetConfig.CreateDefault(kind));
        await OnWorkspaceMutated.InvokeAsync();
    }

    private async Task RemoveWidgetAsync(string widgetId)
    {
        Workspace.Widgets.RemoveAll(w => string.Equals(w.Id, widgetId, StringComparison.Ordinal));
        _waveStates.Remove(widgetId);
        _kpiDrafts.Remove(widgetId);
        await OnWorkspaceMutated.InvokeAsync();
    }

    private async Task MoveWidgetAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= Workspace.Widgets.Count)
        {
            return;
        }

        (Workspace.Widgets[index], Workspace.Widgets[target]) = (Workspace.Widgets[target], Workspace.Widgets[index]);
        await OnWorkspaceMutated.InvokeAsync();
    }

    private async Task SetWidgetSpanAsync(WidgetConfig widget, int colSpan)
    {
        widget.ColSpan = Math.Clamp(colSpan, 3, 12);
        await OnWorkspaceMutated.InvokeAsync();
    }

    private async Task OnWidgetTitleChangedAsync(WidgetConfig widget, ChangeEventArgs e)
    {
        widget.Title = e.Value?.ToString() ?? string.Empty;
        await OnWorkspaceMutated.InvokeAsync();
    }

    private async Task AddWidgetFieldAsync(WidgetConfig widget, string key)
    {
        var trimmed = key.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            return;
        }

        if (!widget.BoundFields.Contains(trimmed, StringComparer.Ordinal))
        {
            widget.BoundFields.Add(trimmed);
            await OnWorkspaceMutated.InvokeAsync();
        }

        GetOrCreateWaveState(widget.Id).HiddenKeys.Remove(trimmed);
    }

    private async Task RemoveWidgetFieldAsync(WidgetConfig widget, string key)
    {
        if (widget.BoundFields.Remove(key))
        {
            await OnWorkspaceMutated.InvokeAsync();
        }

        GetOrCreateWaveState(widget.Id).HiddenKeys.Remove(key);
    }

    private void ToggleWidgetFieldVisibility(string widgetId, string key)
    {
        var hidden = GetOrCreateWaveState(widgetId).HiddenKeys;
        if (!hidden.Add(key))
        {
            hidden.Remove(key);
        }
    }

    private void OnWidgetRangeChanged(string widgetId, (double Start, double End) range)
    {
        var state = GetOrCreateWaveState(widgetId);
        state.ViewStart = Math.Clamp(range.Start, 0.0, 0.95);
        state.ViewEnd = Math.Clamp(range.End, state.ViewStart + 0.05, 1.0);
    }

    private string GetKpiDraft(string widgetId) =>
        _kpiDrafts.TryGetValue(widgetId, out var draft) ? draft : string.Empty;

    private void OpenKpiSuggest(string widgetId)
    {
        _activeKpiSuggestWidgetId = widgetId;
    }

    private void OnKpiDraftInput(string widgetId, ChangeEventArgs e)
    {
        _kpiDrafts[widgetId] = e.Value?.ToString() ?? string.Empty;
        _activeKpiSuggestWidgetId = widgetId;
    }

    private async Task OnKpiInputKeyDownAsync(WidgetConfig widget, KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddKpiDraftAsync(widget);
        }
        else if (e.Key == "Escape")
        {
            _activeKpiSuggestWidgetId = null;
        }
    }

    private async Task AddKpiDraftAsync(WidgetConfig widget)
    {
        var key = GetKpiDraft(widget.Id).Trim();
        if (string.IsNullOrEmpty(key))
        {
            return;
        }

        _kpiDrafts[widget.Id] = string.Empty;
        _activeKpiSuggestWidgetId = null;
        await AddWidgetFieldAsync(widget, key);
    }

    private async Task AddKpiSuggestionAsync(WidgetConfig widget, string key)
    {
        _kpiDrafts[widget.Id] = string.Empty;
        _activeKpiSuggestWidgetId = null;
        await AddWidgetFieldAsync(widget, key);
    }

    private void CloseKpiSuggest() => _activeKpiSuggestWidgetId = null;

    private IReadOnlyList<NumericSeriesSnapshot> GetKpiSuggestions(WidgetConfig widget, string query)
    {
        var existing = new HashSet<string>(widget.BoundFields, StringComparer.Ordinal);
        var q = query.Trim();
        return _allSeries
            .Where(s => !existing.Contains(s.Key))
            .Where(s => string.IsNullOrEmpty(q) || s.Key.Contains(q, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.Key.StartsWith("gsv.", StringComparison.Ordinal) ? 1 : 0)
            .ThenBy(s => s.Key, StringComparer.Ordinal)
            .Take(8)
            .ToArray();
    }

    private async Task OnFieldFilterChangedAsync(WidgetConfig widget, string? filter)
    {
        widget.FieldFilter = filter;
        await OnWorkspaceMutated.InvokeAsync();
    }

    private async Task ExportToClipboardAsync()
    {
        try
        {
            var json = WorkspaceStore.Serialize(Workspace);
            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/LinkStudio.UI/js/workbench.js");
            await _jsModule.InvokeVoidAsync("copyTextToClipboard", json, false);
            _exportToast = "已复制 JSON";
            StateHasChanged();
            await Task.Delay(1600);
            if (!_disposed)
            {
                _exportToast = null;
                StateHasChanged();
            }
        }
        catch (Exception error)
        {
            Serilog.Log.Warning(error, "导出工作空间到剪贴板失败");
        }
    }

    private async Task DetachDragAsync()
    {
        _dragAttached = false;
        if (_dragHandle is not null)
        {
            try
            {
                await _dragHandle.InvokeVoidAsync("dispose");
                await _dragHandle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时忽略前端监听释放异常。
            }

            _dragHandle = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SessionHub.ProtocolDataChanged -= HandleDataChanged;
        SessionHub.ConnectionStateChanged -= HandleDataChanged;
        _refreshThrottleTimer?.Dispose();
        await DetachDragAsync();

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时忽略前端模块释放异常。
            }
        }

        _dotNetRef?.Dispose();
    }
}
