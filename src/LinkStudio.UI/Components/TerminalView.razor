            return;
        }

        var selected = await FilePicker.PickFileAsync(
            "选择要回放的串口或协议日志文件",
            "日志文件 (*.log;*.txt;*.nmea;*.jsonl)|*.log;*.txt;*.nmea;*.jsonl|所有文件 (*.*)|*.*",
            Settings.Serial.SerialLogDirectory);
