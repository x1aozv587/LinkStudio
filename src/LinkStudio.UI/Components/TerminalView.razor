                    <div class="ls-drawer-row ls-drawer-row-stack">
                        <span class="ls-drawer-label">串口日志保存目录</span>
                        <div class="ls-path-picker">
                            <span class="ls-path-display ls-mono" title="@Settings.Serial.SerialLogDirectory">
                                @Settings.Serial.SerialLogDirectory
                            </span>
                            <button type="button"
                                    class="ls-btn-subtle"
                                    disabled="@(!FolderPicker.IsSupported || _isPickingFolder)"
                                    title="@(FolderPicker.IsSupported ? "选择串口日志保存文件夹" : "仅桌面端支持本地文件夹弹窗")"
                                    @onclick="PickSerialLogFolderAsync">
                                选择文件夹…
                            </button>
                        </div>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">日志格式</span>
                        <LinkSelect TValue="string"
                                    Options="_logFormatOptions"
                                    Value="Settings.Serial.SerialLogFormat"
                                    ValueChanged="v => UpdateSetting(() => Settings.Serial.SerialLogFormat = v)"
                                    CssClass="ls-drawer-control"
                                    OpenUpward="true"
                                    AriaLabel="日志格式" />
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

@code {
    private enum DeviceMode
    {
        Serial,
        VirtualMcu,
        LogReplay
    }

    [Parameter, EditorRequired]
    public WorkbenchSettings Settings { get; set; } = default!;

    [Parameter]
    public bool IsVisible { get; set; } = true;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private IFolderPickerService FolderPicker { get; set; } = default!;

    [Inject]
    private IFilePickerService FilePicker { get; set; } = default!;

    [Inject]
    private IFilterWindowService FilterWindowService { get; set; } = default!;

    [Inject]
    private IPresetWindowService PresetWindowService { get; set; } = default!;

    [Inject]
    private TerminalSessionHub SessionHub { get; set; } = default!;

    [Inject]
    private IDeviceChangeMonitor DeviceChangeMonitor { get; set; } = default!;

    private IReadOnlyList<TerminalLogEntry> _entries = [];
    private ElementReference _outputRef;
    private ElementReference _sendTextareaRef;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _scrollWatcher;
    private IJSObjectReference? _sendKeyHandler;
    private DotNetObjectReference<TerminalView>? _dotNetRef;

    private RawDataBus? _bus;
    private ICommunicationDevice? _device;
    private SerialLogRecorder? _logRecorder;
    private ProtocolPipeline? _protocolPipeline;
    private Task? _transition;

    private DeviceMode _mode = DeviceMode.Serial;
    private static readonly string[] _baudPresets =
    [
        "9600", "19200", "38400", "57600", "115200",
        "230400", "460800", "921600", "1000000", "2000000"
    ];

    private static readonly IReadOnlyList<LinkSelect<int>.SelectOption> _dataBitsOptions =
    [
        new(5, "5"), new(6, "6"), new(7, "7"), new(8, "8")
    ];

    private static readonly IReadOnlyList<LinkSelect<StopBits>.SelectOption> _stopBitsOptions =
    [
        new(StopBits.One, "1"),
        new(StopBits.OnePointFive, "1.5"),
        new(StopBits.Two, "2")
    ];

    private static readonly IReadOnlyList<LinkSelect<Parity>.SelectOption> _parityOptions =
    [
        new(Parity.None, "None（无）"),
        new(Parity.Odd, "Odd（奇校验）"),
        new(Parity.Even, "Even（偶校验）"),
        new(Parity.Mark, "Mark"),
        new(Parity.Space, "Space")
    ];

    private static readonly IReadOnlyList<LinkSelect<Handshake>.SelectOption> _flowControlOptions =
    [
        new(Handshake.None, "None（无）"),
        new(Handshake.RequestToSend, "RTS / CTS"),
        new(Handshake.XOnXOff, "XON / XOFF"),
        new(Handshake.RequestToSendXOnXOff, "RTS/CTS + XON/XOFF")
    ];

    private static readonly IReadOnlyList<LinkSelect<int>.SelectOption> _maxLinesOptions =
    [
        new(200, "200 条"),
        new(500, "500 条"),
        new(1000, "1,000 条"),
        new(2000, "2,000 条")
    ];

    private static readonly IReadOnlyList<LinkSelect<string>.SelectOption> _logFormatOptions =
    [
        new(".log", ".log（带时间戳文本）"),
        new(".bin", ".bin（原始二进制）")
    ];

    private static readonly IReadOnlyList<LinkSelect<VirtualMcuSimulationMode>.SelectOption> _virtualSimModeOptions =
    [
        new(VirtualMcuSimulationMode.SimulatedImuJson, "模拟 IMU (JSON)"),
        new(VirtualMcuSimulationMode.SimulatedGnssNmea, "模拟 GNSS (NMEA)"),
        new(VirtualMcuSimulationMode.BasicTick, "基础心跳 (Tick)")
    ];

    private static readonly IReadOnlyList<LinkSelect<double>.SelectOption> _replaySpeedOptions =
    [
        new(0.5, "0.5×"),
        new(1.0, "1×"),
        new(2.0, "2×"),
        new(5.0, "5×"),
        new(10.0, "10×"),
        new(0.0, "全速")
    ];

    private string[] _availablePorts = [];
    private IReadOnlyList<LinkSelect<string>.SelectOption> _portOptions = [];
    private string _selectedPort = string.Empty;
    private string _baudRateText = "1000000";
    private bool _isBaudMenuOpen;

    private VirtualMcuSimulationMode _virtualSimMode = VirtualMcuSimulationMode.SimulatedImuJson;
    private int _virtualIntervalMs = 250;
    private bool _isVirtualAutoSending;
    private bool _isTogglingVirtualAuto;

    private string _replayFilePath = string.Empty;
    private double _replaySpeed = 1.0;
    private bool _replayLoop;

    private string _status = "未连接";
    private string? _connectionError;
    private string _draft = string.Empty;
    private string? _sendError;
    private string? _copyToastText;
    private TerminalLogEntry? _copiedEntry;
    private long? _jumpTargetEntryId;
    private int _copyToastVersion;

    private bool _isSerialSettingsOpen;
    private bool _isPickingFolder;
    private bool _isChanging;
    private bool _isSending;
    private bool _userScrolledUp;
    private bool _pendingScrollToBottom;
    private bool _disposed;

    private long _rxBytes;
    private long _txBytes;
    private Timer? _uiRefreshThrottleTimer;
    private int _uiRefreshScheduled;
    private bool _wasVisible = true;

    private bool _isConnectedOrBusy => _isChanging || _device is not null;

    private bool CanSend => !_disposed && !_isChanging && !_isSending
        && _device?.IsOpen == true
        && _device is not LogReplayDevice
        && !string.IsNullOrEmpty(_draft);

    private bool CanControlVirtualAuto => !_disposed && !_isChanging && !_isTogglingVirtualAuto
        && _device is VirtualMcuDevice { IsOpen: true };

    protected override void OnInitialized()
    {
        _uiRefreshThrottleTimer = new Timer(OnUiRefreshThrottleElapsed, null, Timeout.Infinite, Timeout.Infinite);
        _baudRateText = Settings.Serial.DefaultBaudRate.ToString(CultureInfo.InvariantCulture);
        _entries = SessionHub.GetEntriesSnapshot();
        Settings.Changed += HandleSettingsChanged;
        SessionHub.RulesChanged += HandleFilterRulesChanged;
        SessionHub.JumpToEntryRequested += HandleJumpToEntryRequested;
        DeviceChangeMonitor.DevicesChanged += HandleHardwareDevicesChanged;
        RefreshPorts();
    }

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            // 从其他页面切回终端时，立刻同步一次最新日志快照并滚到底部（若未上翻）。
            _entries = SessionHub.GetEntriesSnapshot();
            if (Settings.Serial.AutoScroll && !_userScrolledUp)
            {
                _pendingScrollToBottom = true;
            }
        }

        _wasVisible = IsVisible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/LinkStudio.UI/js/workbench.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                _scrollWatcher = await _jsModule.InvokeAsync<IJSObjectReference?>(
                    "attachAutoScrollWatcher", _outputRef, _dotNetRef);
                _sendKeyHandler = await _jsModule.InvokeAsync<IJSObjectReference?>(
                    "attachSendTextareaKeyHandler", _sendTextareaRef, _dotNetRef);
            }
            catch (Exception error)
            {
                Serilog.Log.Warning(error, "初始化终端交互脚本失败");
            }
        }

        if (_pendingScrollToBottom && Settings.Serial.AutoScroll && !_userScrolledUp && _jsModule is not null)
        {
            _pendingScrollToBottom = false;
            try
            {
                await _jsModule.InvokeVoidAsync("scrollToBottom", _outputRef);
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时忽略脚本调用异常。
            }
        }
    }

    [JSInvokable]
    public void OnTerminalScrollPositionChanged(bool isNearBottom)
    {
        if (_disposed)
        {
            return;
        }

        var scrolledUp = !isNearBottom;
        if (_userScrolledUp != scrolledUp)
        {
            _userScrolledUp = scrolledUp;
            if (!scrolledUp)
            {
                // 用户重新滚回底部时，恢复常规行数上限裁剪，释放临时保留的历史行。
                TrimEntriesToLimit();
            }

            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnSendShortcutAsync()
    {
        if (CanSend)
        {
            await SendAsync();
            StateHasChanged();
        }
    }

    private void HandleSettingsChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            if (_device is null)
            {
                _baudRateText = Settings.Serial.DefaultBaudRate.ToString(CultureInfo.InvariantCulture);
                if (!string.IsNullOrWhiteSpace(Settings.Serial.LastPortName)
                    && _availablePorts.Contains(Settings.Serial.LastPortName, StringComparer.OrdinalIgnoreCase))
                {
                    _selectedPort = Settings.Serial.LastPortName;
                }
            }

            TrimEntriesToLimit();
            StateHasChanged();
        });
    }

    private void HandleHardwareDevicesChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            RefreshPorts();

            // 如果当前正打开的真实串口已从系统端口列表消失，说明设备被物理拔出：
            // 立即记日志、提示用户并自动关闭连接与串口日志，无需用户再手动点关闭。
            if (_device is SerialPortDevice activeSerial
                && !_isChanging
                && !_availablePorts.Contains(activeSerial.Name, StringComparer.OrdinalIgnoreCase))
            {
                var removedPort = activeSerial.Name;
                Serilog.Log.Warning("检测到当前串口 {PortName} 已被拔出，自动关闭连接", removedPort);
                AppendSystemEntry($"检测到串口 {removedPort} 已被拔出，已自动关闭连接。");
                _connectionError = $"串口 {removedPort} 已被拔出，已自动关闭。";

                _isChanging = true;
                try
                {
                    await StopSessionAsync();
                    _status = "设备已拔出";
                }
                finally
                {
                    _isChanging = false;
                }

                RefreshPorts();
            }

            StateHasChanged();
        });
    }

    private void HandleFilterRulesChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void HandleJumpToEntryRequested(long entryId)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            // 主动跳转到历史命中项时暂停自动贴底，避免下一包数据立刻把视角拉回底部。
            _jumpTargetEntryId = entryId;
            _userScrolledUp = true;
            StateHasChanged();

            if (_jsModule is not null)
            {
                try
                {
                    await _jsModule.InvokeVoidAsync("scrollToEntry", _outputRef, entryId);
                }
                catch (JSDisconnectedException)
                {
                    // 页面断开时忽略脚本调用异常。
                }
            }
        });
    }

    private async Task CopyEntryAsync(TerminalLogEntry entry)
    {
        if (_jsModule is null)
        {
            return;
        }

        var line = TerminalSessionHub.BuildCopyLine(entry, Settings.Serial);
        if (string.IsNullOrEmpty(line))
        {
            return;
        }

        try
        {
            var copied = await _jsModule.InvokeAsync<bool>("copyTextToClipboard", line, true);
            if (copied)
            {
                await ShowCopyToastAsync(entry, "已复制该条");
            }
        }
        catch (JSDisconnectedException)
        {
            // 页面断开时忽略脚本调用异常。
        }
    }

    private async Task ShowCopyToastAsync(TerminalLogEntry? entry, string text)
    {
        var version = ++_copyToastVersion;
        _copiedEntry = entry;
        _copyToastText = text;
        StateHasChanged();

        if (entry is not null)
        {
            await Task.Delay(320);
            if (!_disposed && _copyToastVersion == version)
            {
                _copiedEntry = null;
                StateHasChanged();
            }

            await Task.Delay(980);
        }
        else
        {
            await Task.Delay(1300);
        }

        if (!_disposed && _copyToastVersion == version)
        {
            _copyToastText = null;
            StateHasChanged();
        }
    }

    private void SelectBaudRate(string baudRate)
    {
        _baudRateText = baudRate;
        _isBaudMenuOpen = false;
    }

    private void SelectMode(DeviceMode mode)
    {
        if (_isConnectedOrBusy || _mode == mode)
        {
            return;
        }

        _mode = mode;
        _connectionError = null;
        if (mode == DeviceMode.Serial)
        {
            RefreshPorts();
        }
    }

    private void RefreshPorts()
    {
        try
        {
            _availablePorts = SerialPortDevice.GetAvailablePorts()
                .OrderBy(p => p, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            _portOptions = _availablePorts.Select(p => new LinkSelect<string>.SelectOption(p, p)).ToArray();

            if (_availablePorts.Length == 0)
            {
                _selectedPort = string.Empty;
            }
            else if (!_availablePorts.Contains(_selectedPort, StringComparer.OrdinalIgnoreCase))
            {
                _selectedPort = _availablePorts[0];
            }
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "枚举本机串口列表失败");
            _availablePorts = [];
            _portOptions = [];
            _selectedPort = string.Empty;
            _connectionError = "枚举串口列表失败，请检查系统串口驱动。";
        }
    }

    private string GetConnectButtonText()
    {
        if (_isChanging)
        {
            return _device is null ? "连接中…" : "关闭中…";
        }

        if (_mode == DeviceMode.VirtualMcu)
        {
            return _device is null ? "启动虚拟设备" : "停止虚拟设备";
        }

        if (_mode == DeviceMode.LogReplay)
        {
            return _device is null ? "加载回放" : "停止回放";
        }

        return _device is null ? "打开串口" : "关闭串口";
    }

    private Task ToggleConnectionAsync()
    {
        if (_disposed || _isChanging)
        {
            return Task.CompletedTask;
        }

        _transition = ChangeSessionAsync();
        return _transition;
    }

    private async Task ChangeSessionAsync()
    {
        _isChanging = true;
        _connectionError = null;

        try
        {
            if (_device is null)
            {
                _status = "正在连接…";
                _sendError = null;
                await StartSessionAsync();
            }
            else
            {
                _status = "正在断开…";
                await StopSessionAsync();
                _status = "已断开";
            }
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "切换设备连接状态失败");
            _connectionError = error.Message;
            _status = "连接失败";
        }
        finally
        {
            _isChanging = false;
        }
    }

    private async Task StartSessionAsync()
    {
        var bus = new RawDataBus();
        ICommunicationDevice device;

        if (_mode == DeviceMode.Serial)
        {
            if (string.IsNullOrWhiteSpace(_selectedPort))
            {
                await bus.DisposeAsync();
                throw new InvalidOperationException("请先选择一个可用的串口。");
            }

            if (!int.TryParse(_baudRateText.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var baudRate)
                || baudRate <= 0)
            {
                await bus.DisposeAsync();
                throw new InvalidOperationException("波特率必须是大于 0 的整数。");
            }

            var config = Settings.CreateSerialConfig(_selectedPort, baudRate);
            var serialDevice = new SerialPortDevice(bus, config);
            serialDevice.Faulted += HandleSerialFaulted;
            device = serialDevice;

            // 记住本次连接使用的串口与波特率，方便下次打开自动预选。
            if (!string.Equals(Settings.Serial.LastPortName, _selectedPort, StringComparison.OrdinalIgnoreCase)
                || Settings.Serial.DefaultBaudRate != baudRate)
            {
                Settings.Serial.LastPortName = _selectedPort;
                Settings.Serial.DefaultBaudRate = baudRate;
                Settings.NotifyChanged();
            }
        }
        else if (_mode == DeviceMode.VirtualMcu)
        {
            var virtualDevice = new VirtualMcuDevice(bus);
            await virtualDevice.SetSimulationModeAsync(_virtualSimMode);
            device = virtualDevice;
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_replayFilePath) || !File.Exists(_replayFilePath))
            {
                await bus.DisposeAsync();
                throw new InvalidOperationException("请先选择一个存在的日志文件。");
            }

            var frames = await LogReplayParser.LoadFileAsync(_replayFilePath);
            if (frames.Count == 0)
            {
                await bus.DisposeAsync();
                throw new InvalidOperationException("所选日志文件中未找到可回放的数据行。");
            }

            var replayDevice = new LogReplayDevice(bus, Path.GetFileName(_replayFilePath), frames);
            replayDevice.SetSpeed(_replaySpeed);
            replayDevice.Loop = _replayLoop;
            replayDevice.ProgressChanged += HandleReplayProgressChanged;
            device = replayDevice;
        }

        _bus = bus;
        _device = device;

        try
        {
            if (Settings.Serial.AutoSaveSerialLogOnOpen && device is not LogReplayDevice)
            {
                // 作为独立订阅者挂到 RawDataBus 上，按当前列设置异步写盘，不阻塞界面与串口收发。
                _logRecorder = new SerialLogRecorder(
                    bus,
                    device.Id,
                    Settings.Serial.SerialLogDirectory,
                    device.Name,
                    () => Settings.CreateSerialLogOptions());
            }

            // 挂载协议解析管线（独立订阅者）：自动执行跨包分帧与 NMEA / JSON 解析。
            _protocolPipeline = new ProtocolPipeline(
                bus,
                device.Id,
                new LineFramer(),
                [new NmeaProtocolParser(), new JsonProtocolParser()],
                parsed =>
                {
                    SessionHub.AddParsedFrame(parsed);
                    return ValueTask.CompletedTask;
                });

            bus.Subscribe(
                new(device.Id, Capacity: Math.Max(Settings.Serial.MaxDisplayLines, 256), OverflowPolicy: RawDataOverflowPolicy.DropOldest),
                (packet, _) => OnPacketReceivedAsync(bus, packet));

            await device.OpenAsync();
            SessionHub.SetActiveDevice(device);

            if (device is LogReplayDevice startedReplay)
            {
                startedReplay.Play();
                _status = $"回放中 · {startedReplay.Name}（{startedReplay.TotalFrames} 帧）";
            }
            else
            {
                _status = _mode == DeviceMode.Serial
                    ? $"已连接 {_selectedPort} · {_baudRateText.Trim()} bps"
                    : "虚拟 MCU 运行中";
            }
        }
        catch
        {
            await StopSessionAsync();
            throw;
        }
    }

    private void HandleSerialFaulted(object? sender, Exception error)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed || !ReferenceEquals(_device, sender))
            {
                return;
            }

            AppendSystemEntry($"串口发生故障已断开：{error.Message}");
            _connectionError = $"串口异常断开：{error.Message}";
            await StopSessionAsync();
            _status = "异常断开";
            RefreshPorts();
            StateHasChanged();
        });
    }

    private async Task StopSessionAsync()
    {
        SessionHub.SetActiveDevice(null);

        var device = _device;
        var recorder = _logRecorder;
        var pipeline = _protocolPipeline;
        var bus = _bus;

        _device = null;
        _logRecorder = null;
        _protocolPipeline = null;
        _bus = null;
        _isVirtualAutoSending = false;

        if (device is SerialPortDevice serialDevice)
        {
            serialDevice.Faulted -= HandleSerialFaulted;
        }
        else if (device is LogReplayDevice replayDevice)
        {
            replayDevice.ProgressChanged -= HandleReplayProgressChanged;
        }

        try
        {
            if (device is not null)
            {
                await device.DisposeAsync();
            }
        }
        finally
        {
            try
            {
                // 先释放总线以排空总线上尚未分发给订阅者的尾包，确保日志记录器与协议管线全部处理完。
                if (bus is not null)
                {
                    await bus.DisposeAsync();
                }
            }
            finally
            {
                if (pipeline is not null)
                {
                    await pipeline.DisposeAsync();
                }

                if (recorder is not null)
                {
                    await recorder.DisposeAsync();
                }
            }
        }
    }

    private async Task PickReplayFileAsync()
    {
