    private void HandleReplayProgressChanged()
    {
        if (_disposed || !IsVisible)
        {
            return;
        }

        if (Interlocked.CompareExchange(ref _uiRefreshScheduled, 1, 0) == 0)
        {
            _uiRefreshThrottleTimer?.Change(60, Timeout.Infinite);
        }
    }

    private void ToggleReplayPlayPause()
    {
        if (_device is not LogReplayDevice replay)
        {
            return;
        }

        if (replay.IsPlaying)
        {
            replay.Pause();
        }
        else
        {
            replay.Play();
        }
    }

    private void RestartReplay()
    {
        if (_device is not LogReplayDevice replay)
        {
            return;
        }

        replay.Pause();
        ClearEntries();
        SessionHub.ClearProtocolData();
        replay.Seek(0);
        replay.Play();
    }

    private void OnReplaySpeedChanged(double speed)
    {
        _replaySpeed = speed;
        if (_device is LogReplayDevice replay)
        {
            replay.SetSpeed(speed);
        }
    }

    private void ToggleReplayLoop()
    {
        _replayLoop = !_replayLoop;
        if (_device is LogReplayDevice replay)
        {
            replay.Loop = _replayLoop;
        }
    }

    private void OnReplaySeekInput(ChangeEventArgs e)
    {
        if (_device is LogReplayDevice replay
            && int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx))
