@using System.Globalization
@using System.IO.Ports
@using System.Text
@using LinkStudio.Core.Bus
@using LinkStudio.Core.Devices
@using LinkStudio.Core.Devices.Serial
@using LinkStudio.Core.Devices.Virtual
@using LinkStudio.Core.Helper
@using LinkStudio.Core.Services
@implements IAsyncDisposable

<div class="ls-terminal-page">
    <!-- 顶部精简连接栏：选串口、波特率、开关与精简显示切换 -->
    <header class="ls-topbar">
        <div class="ls-topbar-group">
            <div class="ls-segmented" role="group" aria-label="设备模式">
                <button type="button"
                        class="ls-seg-btn @(_mode == DeviceMode.Serial ? "is-active" : string.Empty)"
                        disabled="@(_isConnectedOrBusy)"
                        @onclick="() => SelectMode(DeviceMode.Serial)">
                    真实串口
                </button>
                <button type="button"
                        class="ls-seg-btn @(_mode == DeviceMode.VirtualMcu ? "is-active" : string.Empty)"
                        disabled="@(_isConnectedOrBusy)"
                        @onclick="() => SelectMode(DeviceMode.VirtualMcu)">
                    虚拟 MCU
                </button>
            </div>

            @if (_mode == DeviceMode.Serial)
            {
                <div class="ls-port-picker">
                    <select class="ls-select ls-mono"
                            aria-label="选择串口"
                            @bind="_selectedPort"
                            disabled="@(_isConnectedOrBusy || _availablePorts.Length == 0)">
                        @if (_availablePorts.Length == 0)
                        {
                            <option value="">未检测到串口</option>
                        }
                        else
                        {
                            @foreach (var port in _availablePorts)
                            {
                                <option value="@port">@port</option>
                            }
                        }
                    </select>
                    <button type="button"
                            class="ls-icon-btn"
                            title="刷新串口列表"
                            aria-label="刷新串口列表"
                            disabled="@(_isConnectedOrBusy)"
                            @onclick="RefreshPorts">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                            <polyline points="21 3 21 9 15 9" />
                        </svg>
                    </button>
                </div>

                <div class="ls-baud-box">
                    <span class="ls-inline-label">波特率</span>
                    <input class="ls-input ls-baud-input ls-mono"
                           type="text"
                           inputmode="numeric"
                           list="ls-baud-presets"
                           aria-label="波特率"
                           @bind="_baudRateText"
                           disabled="@(_isConnectedOrBusy)" />
                    <datalist id="ls-baud-presets">
                        <option value="9600" />
                        <option value="19200" />
                        <option value="38400" />
                        <option value="57600" />
                        <option value="115200" />
                        <option value="230400" />
                        <option value="460800" />
                        <option value="921600" />
                        <option value="1000000" />
                        <option value="2000000" />
                    </datalist>
                </div>
            }
            else
            {
                <div class="ls-virtual-controls">
                    <span class="ls-badge-muted ls-mono">virtual-mcu-1</span>
                    <span class="ls-inline-label">周期</span>
                    <input class="ls-input ls-interval-input ls-mono"
                           type="number"
                           min="10"
                           step="100"
                           aria-label="虚拟设备自动发送周期（毫秒）"
                           @bind="_virtualIntervalMs"
                           disabled="@(!CanControlVirtualAuto)" />
                    <span class="ls-inline-unit">ms</span>
                    <button type="button"
                            class="ls-btn-subtle @(_isVirtualAutoSending ? "is-accent" : string.Empty)"
                            disabled="@(!CanControlVirtualAuto)"
                            @onclick="StartVirtualAutoAsync">
                        Start
                    </button>
                    <button type="button"
                            class="ls-btn-subtle"
                            disabled="@(!CanControlVirtualAuto || !_isVirtualAutoSending)"
                            @onclick="StopVirtualAutoAsync">
                        Stop
                    </button>
                </div>
            }

            <button type="button"
                    class="ls-connect-btn @(_device is not null ? "is-open" : string.Empty)"
                    disabled="@(_isChanging || (_mode == DeviceMode.Serial && _device is null && string.IsNullOrWhiteSpace(_selectedPort)))"
                    @onclick="ToggleConnectionAsync">
                <span class="ls-status-dot @(_device?.IsOpen == true ? "is-live" : string.Empty)"></span>
                @GetConnectButtonText()
            </button>
        </div>

        <div class="ls-topbar-group ls-topbar-right">
            <!-- 精简为 UTF-8（中文）与 HEX 两档切换 -->
            <div class="ls-segmented" role="group" aria-label="接收显示格式">
                <button type="button"
                        class="ls-seg-btn @(Settings.Serial.DisplayMode == TerminalDisplayMode.Utf8 ? "is-active" : string.Empty)"
                        @onclick="() => SetDisplayMode(TerminalDisplayMode.Utf8)">
                    UTF-8
                </button>
                <button type="button"
                        class="ls-seg-btn @(Settings.Serial.DisplayMode == TerminalDisplayMode.Hex ? "is-active" : string.Empty)"
                        @onclick="() => SetDisplayMode(TerminalDisplayMode.Hex)">
                    HEX
                </button>
            </div>

            <button type="button"
                    class="ls-pill-toggle @(Settings.Serial.AutoScroll ? "is-active" : string.Empty)"
                    title="收到新数据时自动滚到底部"
                    @onclick="ToggleAutoScroll">
                自动滚屏
            </button>

            <button type="button"
                    class="ls-icon-btn"
                    title="清空接收区"
                    aria-label="清空接收区"
                    @onclick="ClearEntries">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6" />
                    <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" />
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                </svg>
            </button>

            <button type="button"
                    class="ls-icon-btn @(_isSerialSettingsOpen ? "is-active" : string.Empty)"
                    title="串口终端设置（参数、显示列、快捷键与串口日志）"
                    aria-label="串口终端设置"
                    @onclick="() => _isSerialSettingsOpen = !_isSerialSettingsOpen">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14" />
                    <line x1="4" y1="10" x2="4" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12" y2="3" />
                    <line x1="20" y1="21" x2="20" y2="16" />
                    <line x1="20" y1="12" x2="20" y2="3" />
                    <line x1="1" y1="14" x2="7" y2="14" />
                    <line x1="9" y1="8" x2="15" y2="8" />
                    <line x1="17" y1="16" x2="23" y2="16" />
                </svg>
            </button>
        </div>
    </header>

    @if (_connectionError is not null)
    {
        <div class="ls-banner-error" role="alert">
            <span>@_connectionError</span>
            <button type="button" class="ls-banner-close" @onclick="() => _connectionError = null">×</button>
        </div>
    }

    <!-- 中间超大接收区：支持焦点内 Ctrl+A 仅全选接收区、拖拽连带时间复制、双击复制整行 -->
    <section class="ls-receive-stage" aria-label="数据接收区">
        <div class="ls-terminal-viewport ls-mono"
             tabindex="0"
             style="font-size: @(Settings.Serial.FontSizePx)px;"
             @ref="_outputRef">
            @if (_entries.Count == 0)
            {
                <div class="ls-empty-state">
                    <div class="ls-empty-title">准备就绪</div>
                    <p class="ls-empty-hint">
                        @if (_mode == DeviceMode.Serial)
                        {
                            <span>选择串口与波特率后点击「打开串口」，收发数据将实时显示在这里（双击任意行可快速复制）。</span>
                        }
                        else
                        {
                            <span>点击「启动虚拟设备」即可无硬件测试收发与定时发送（双击任意行可快速复制）。</span>
                        }
                    </p>
                </div>
            }
            else
            {
                @foreach (var entry in _entries)
                {
                    <div class="ls-log-row @GetRowCssClass(entry) @(ReferenceEquals(_copiedEntry, entry) ? "is-copied" : string.Empty)"
                         title="双击复制整条内容"
                         @ondblclick="() => CopyEntryAsync(entry)">
                        @if (Settings.Serial.ShowTimestamp)
                        {
                            <span class="ls-log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                        }
                        @if (Settings.Serial.ShowDirection)
                        {
                            <span class="ls-log-dir @GetDirCssClass(entry)">@entry.Direction</span>
                        }
                        @if (Settings.Serial.ShowPayload)
                        {
                            <span class="ls-log-body">@FormatEntryText(entry)</span>
                        }
                    </div>
                }
            }
        </div>

        @if (_copyToastText is not null)
        {
            <div class="ls-copy-toast" role="status">@_copyToastText</div>
        }

        @if (_userScrolledUp && _entries.Count > 0)
        {
            <button type="button"
                    class="ls-scroll-bottom-fab"
                    @onclick="JumpToBottomAsync">
                ↓ 回到底部
            </button>
        }

        <!-- 底部状态栏：颜色与接收区明确区分 -->
        <div class="ls-receive-statusbar">
            <div class="ls-status-metrics ls-mono">
                <span class="ls-status-pill @(_device?.IsOpen == true ? "is-connected" : string.Empty)">
                    <span class="ls-status-pill-dot"></span>
                    @_status
                </span>
                @if (_logRecorder is not null)
                {
                    <span class="ls-rec-pill" title="@($"正在自动保存日志：{_logRecorder.FilePath}")">
                        ● REC
                    </span>
                }
                <span>RX <strong class="ls-text-rx">@_rxBytes.ToString("N0")</strong> B</span>
                <span>TX <strong class="ls-text-tx">@_txBytes.ToString("N0")</strong> B</span>
                <span>@_entries.Count 条</span>
            </div>

            <div class="ls-font-control">
                <label for="ls-font-slider" class="ls-inline-label">字号</label>
                <input id="ls-font-slider"
                       class="ls-range"
                       type="range"
                       min="@WorkbenchSettings.SliderMinFontSize"
                       max="@WorkbenchSettings.SliderMaxFontSize"
                       value="@Math.Clamp(Settings.Serial.FontSizePx, WorkbenchSettings.SliderMinFontSize, WorkbenchSettings.SliderMaxFontSize)"
                       @oninput="OnFontSizeInput" />
                <div class="ls-number-pill">
                    <input class="ls-number-bare ls-mono"
                           type="number"
                           min="@WorkbenchSettings.InputMinFontSize"
                           max="@WorkbenchSettings.InputMaxFontSize"
                           aria-label="字体大小像素值"
                           value="@Settings.Serial.FontSizePx"
                           @onchange="OnFontSizeInput" />
                    <span class="ls-number-unit">px</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 底部紧凑多行发送区 -->
    <footer class="ls-send-dock">
        <div class="ls-send-box">
            <textarea class="ls-textarea ls-mono"
                      rows="2"
                      @ref="_sendTextareaRef"
                      data-enter-to-send="@(Settings.Serial.EnterToSend ? "true" : "false")"
                      placeholder="@(Settings.Serial.SendAsHex ? "支持多行输入 HEX 字节，例如：\n41 54 0D 0A\n0xAA 0x55" : "支持多行发送文本...")"
                      @bind="_draft"
                      @bind:event="oninput"
                      disabled="@(_isChanging || _device?.IsOpen != true)"></textarea>

            <div class="ls-send-actions">
                <div class="ls-send-options" role="group" aria-label="发送格式选项">
                    <button type="button"
                            class="ls-pill-toggle @(Settings.Serial.SendAsHex ? "is-active" : string.Empty)"
                            @onclick="() => ToggleSetting(() => Settings.Serial.SendAsHex = !Settings.Serial.SendAsHex)">
                        HEX
                    </button>
                    <button type="button"
                            class="ls-pill-toggle @(Settings.Serial.AppendCr ? "is-active" : string.Empty)"
                            title="发送末尾追加回车 0x0D"
                            @onclick="() => ToggleSetting(() => Settings.Serial.AppendCr = !Settings.Serial.AppendCr)">
                        \r
                    </button>
                    <button type="button"
                            class="ls-pill-toggle @(Settings.Serial.AppendLf ? "is-active" : string.Empty)"
                            title="发送末尾追加换行 0x0A"
                            @onclick="() => ToggleSetting(() => Settings.Serial.AppendLf = !Settings.Serial.AppendLf)">
                        \n
                    </button>
                    <span class="ls-shortcut-hint">
                        @(Settings.Serial.EnterToSend ? "Enter 发送 · Shift+Enter 换行" : "Ctrl+Enter 发送 · Enter 换行")
                    </span>
                </div>

                <button type="button"
                        class="ls-send-btn"
                        disabled="@(!CanSend)"
                        @onclick="SendAsync">
                    @(_isSending ? "发送中…" : "发送")
                </button>
            </div>
        </div>

        @if (_sendError is not null)
        {
            <p class="ls-send-error" role="alert">@_sendError</p>
        }
    </footer>

    <!-- 串口工作区专属设置抽屉（常驻 DOM，带滑入/滑出过渡动画） -->
    <div class="ls-drawer-backdrop @(_isSerialSettingsOpen ? "is-open" : string.Empty)"
         aria-hidden="@(!_isSerialSettingsOpen)"
         @onclick="() => _isSerialSettingsOpen = false">
        <aside class="ls-drawer" aria-label="串口终端设置" @onclick:stopPropagation="true">
            <header class="ls-drawer-header">
                <div>
                    <h3>串口终端设置</h3>
                    <p>所有与串口收发、显示和日志相关的选项都在这里</p>
                </div>
                <button type="button"
                        class="ls-icon-btn"
                        title="关闭"
                        aria-label="关闭串口设置"
                        @onclick="() => _isSerialSettingsOpen = false">
                    ×
                </button>
            </header>

            <div class="ls-drawer-body">
                <!-- 1. 串口高级参数 -->
                <div class="ls-drawer-group">
                    <h4 class="ls-drawer-group-title">串口高级参数（下次打开生效）</h4>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">默认波特率</span>
                        <input class="ls-input ls-drawer-control ls-mono"
                               type="number"
                               min="300"
                               step="100"
                               value="@Settings.Serial.DefaultBaudRate"
                               @onchange="OnDefaultBaudChanged" />
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">数据位（Data Bits）</span>
                        <select class="ls-select ls-drawer-control"
                                value="@Settings.Serial.DataBits"
                                @onchange="OnDataBitsChanged">
                            <option value="5">5</option>
                            <option value="6">6</option>
                            <option value="7">7</option>
                            <option value="8">8</option>
                        </select>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">停止位（Stop Bits）</span>
                        <select class="ls-select ls-drawer-control"
                                value="@Settings.Serial.StopBits"
                                @onchange="OnStopBitsChanged">
                            <option value="@StopBits.One">1</option>
                            <option value="@StopBits.OnePointFive">1.5</option>
                            <option value="@StopBits.Two">2</option>
                        </select>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">校验位（Parity）</span>
                        <select class="ls-select ls-drawer-control"
                                value="@Settings.Serial.Parity"
                                @onchange="OnParityChanged">
                            <option value="@Parity.None">None（无）</option>
                            <option value="@Parity.Odd">Odd（奇校验）</option>
                            <option value="@Parity.Even">Even（偶校验）</option>
                            <option value="@Parity.Mark">Mark</option>
                            <option value="@Parity.Space">Space</option>
                        </select>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">流控（Handshake）</span>
                        <select class="ls-select ls-drawer-control"
                                value="@Settings.Serial.FlowControl"
                                @onchange="OnFlowControlChanged">
                            <option value="@Handshake.None">None（无）</option>
                            <option value="@Handshake.RequestToSend">RTS / CTS</option>
                            <option value="@Handshake.XOnXOff">XON / XOFF</option>
                            <option value="@Handshake.RequestToSendXOnXOff">RTS/CTS + XON/XOFF</option>
                        </select>
                    </div>
                </div>

                <!-- 2. 终端显示与列控制 -->
                <div class="ls-drawer-group">
                    <h4 class="ls-drawer-group-title">终端显示与列控制</h4>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">显示时间栏</span>
                        <label class="ls-switch">
                            <input type="checkbox"
                                   checked="@Settings.Serial.ShowTimestamp"
                                   @onchange="e => UpdateBool(v => Settings.Serial.ShowTimestamp = v, e)" />
                            <span class="ls-switch-track"></span>
                        </label>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">显示 TX / RX 栏</span>
                        <label class="ls-switch">
                            <input type="checkbox"
                                   checked="@Settings.Serial.ShowDirection"
                                   @onchange="e => UpdateBool(v => Settings.Serial.ShowDirection = v, e)" />
                            <span class="ls-switch-track"></span>
                        </label>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">显示文本内容栏</span>
                        <label class="ls-switch">
                            <input type="checkbox"
                                   checked="@Settings.Serial.ShowPayload"
                                   @onchange="e => UpdateBool(v => Settings.Serial.ShowPayload = v, e)" />
                            <span class="ls-switch-track"></span>
                        </label>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">智能自动滚屏</span>
                        <label class="ls-switch">
                            <input type="checkbox"
                                   checked="@Settings.Serial.AutoScroll"
                                   @onchange="e => UpdateBool(v => Settings.Serial.AutoScroll = v, e)" />
                            <span class="ls-switch-track"></span>
                        </label>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">界面最大保留条数</span>
                        <select class="ls-select ls-drawer-control"
                                value="@Settings.Serial.MaxDisplayLines"
                                @onchange="OnMaxLinesChanged">
                            <option value="200">200 条</option>
                            <option value="500">500 条</option>
                            <option value="1000">1,000 条</option>
                            <option value="2000">2,000 条</option>
                        </select>
                    </div>
                </div>

                <!-- 3. 发送与快捷键行为 -->
                <div class="ls-drawer-group">
                    <h4 class="ls-drawer-group-title">发送与快捷键</h4>

                    <div class="ls-drawer-row">
                        <div class="ls-setting-info">
                            <span class="ls-drawer-label">按 Enter 直接发送</span>
                            <span class="ls-setting-desc">开启：Enter 发送 / Shift+Enter 换行；关闭：Ctrl+Enter 发送。</span>
                        </div>
                        <label class="ls-switch">
                            <input type="checkbox"
                                   checked="@Settings.Serial.EnterToSend"
                                   @onchange="e => UpdateBool(v => Settings.Serial.EnterToSend = v, e)" />
                            <span class="ls-switch-track"></span>
                        </label>
                    </div>
                </div>

                <!-- 4. 串口收发数据日志 -->
                <div class="ls-drawer-group">
                    <h4 class="ls-drawer-group-title">串口收发数据日志</h4>

                    <div class="ls-drawer-row">
                        <div class="ls-setting-info">
                            <span class="ls-drawer-label">打开串口后自动保存日志</span>
                            <span class="ls-setting-desc">独立于全局应用运行日志，仅记录串口 RX/TX 数据。</span>
                        </div>
                        <label class="ls-switch">
                            <input type="checkbox"
                                   checked="@Settings.Serial.AutoSaveSerialLogOnOpen"
                                   @onchange="OnAutoSaveSerialLogChangedAsync" />
                            <span class="ls-switch-track"></span>
                        </label>
                    </div>

                    <div class="ls-drawer-row ls-drawer-row-stack">
                        <span class="ls-drawer-label">串口日志保存目录</span>
                        <div class="ls-path-picker">
                            <span class="ls-path-display ls-mono" title="@Settings.Serial.SerialLogDirectory">
                                @Settings.Serial.SerialLogDirectory
                            </span>
                            <button type="button"
                                    class="ls-btn-subtle"
                                    disabled="@(!FolderPicker.IsSupported || _isPickingFolder)"
                                    title="@(FolderPicker.IsSupported ? "选择串口日志保存文件夹" : "仅桌面端支持本地文件夹弹窗")"
                                    @onclick="PickSerialLogFolderAsync">
                                选择文件夹…
                            </button>
                        </div>
                    </div>

                    <div class="ls-drawer-row">
                        <span class="ls-drawer-label">日志格式</span>
                        <select class="ls-select ls-drawer-control"
                                value="@Settings.Serial.SerialLogFormat"
                                @onchange="OnSerialLogFormatChanged">
                            <option value=".log">.log（带时间戳文本）</option>
                            <option value=".bin">.bin（原始二进制）</option>
                        </select>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

@code {
    private enum DeviceMode
    {
        Serial,
        VirtualMcu
    }

    private sealed record TerminalEntry(
        DateTimeOffset Timestamp,
        string Direction,
        uint? SeqNo,
        byte[] Payload,
        string? SystemMessage = null);

    [Parameter, EditorRequired]
    public WorkbenchSettings Settings { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private IFolderPickerService FolderPicker { get; set; } = default!;

    private readonly List<TerminalEntry> _entries = [];
    private ElementReference _outputRef;
    private ElementReference _sendTextareaRef;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _scrollWatcher;
    private IJSObjectReference? _sendKeyHandler;
    private DotNetObjectReference<TerminalView>? _dotNetRef;

    private RawDataBus? _bus;
    private ICommunicationDevice? _device;
    private SerialLogRecorder? _logRecorder;
    private Task? _transition;

    private DeviceMode _mode = DeviceMode.Serial;
    private string[] _availablePorts = [];
    private string _selectedPort = string.Empty;
    private string _baudRateText = "1000000";

    private int _virtualIntervalMs = 1000;
    private bool _isVirtualAutoSending;
    private bool _isTogglingVirtualAuto;

    private string _status = "未连接";
    private string? _connectionError;
    private string _draft = string.Empty;
    private string? _sendError;
    private string? _copyToastText;
    private TerminalEntry? _copiedEntry;
    private int _copyToastVersion;

    private bool _isSerialSettingsOpen;
    private bool _isPickingFolder;
    private bool _isChanging;
    private bool _isSending;
    private bool _userScrolledUp;
    private bool _pendingScrollToBottom;
    private bool _disposed;

    private long _rxBytes;
    private long _txBytes;

    private bool _isConnectedOrBusy => _isChanging || _device is not null;

    private bool CanSend => !_disposed && !_isChanging && !_isSending
        && _device?.IsOpen == true && !string.IsNullOrEmpty(_draft);

    private bool CanControlVirtualAuto => !_disposed && !_isChanging && !_isTogglingVirtualAuto
        && _device is VirtualMcuDevice { IsOpen: true };

    protected override void OnInitialized()
    {
        _baudRateText = Settings.Serial.DefaultBaudRate.ToString(CultureInfo.InvariantCulture);
        Settings.Changed += HandleSettingsChanged;
        RefreshPorts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/LinkStudio.UI/js/workbench.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                _scrollWatcher = await _jsModule.InvokeAsync<IJSObjectReference?>(
                    "attachAutoScrollWatcher", _outputRef, _dotNetRef);
                _sendKeyHandler = await _jsModule.InvokeAsync<IJSObjectReference?>(
                    "attachSendTextareaKeyHandler", _sendTextareaRef, _dotNetRef);
            }
            catch (Exception error)
            {
                Serilog.Log.Warning(error, "初始化终端交互脚本失败");
            }
        }

        if (_pendingScrollToBottom && Settings.Serial.AutoScroll && !_userScrolledUp && _jsModule is not null)
        {
            _pendingScrollToBottom = false;
            try
            {
                await _jsModule.InvokeVoidAsync("scrollToBottom", _outputRef);
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时忽略脚本调用异常。
            }
        }
    }

    [JSInvokable]
    public void OnTerminalScrollPositionChanged(bool isNearBottom)
    {
        if (_disposed)
        {
            return;
        }

        var scrolledUp = !isNearBottom;
        if (_userScrolledUp != scrolledUp)
        {
            _userScrolledUp = scrolledUp;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnSendShortcutAsync()
    {
        if (CanSend)
        {
            await SendAsync();
            StateHasChanged();
        }
    }

    private void HandleSettingsChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            if (_device is null)
            {
                _baudRateText = Settings.Serial.DefaultBaudRate.ToString(CultureInfo.InvariantCulture);
                if (!string.IsNullOrWhiteSpace(Settings.Serial.LastPortName)
                    && _availablePorts.Contains(Settings.Serial.LastPortName, StringComparer.OrdinalIgnoreCase))
                {
                    _selectedPort = Settings.Serial.LastPortName;
                }
            }

            TrimEntriesToLimit();
            StateHasChanged();
        });
    }

    private async Task CopyEntryAsync(TerminalEntry entry)
    {
        if (_jsModule is null)
        {
            return;
        }

        // 按当前勾选的可见列拼出整行文本，所见即所复制。
        var parts = new List<string>(3);
        if (Settings.Serial.ShowTimestamp)
        {
            parts.Add(entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff"));
        }

        if (Settings.Serial.ShowDirection)
        {
            parts.Add(entry.Direction);
        }

        if (Settings.Serial.ShowPayload)
        {
            parts.Add(FormatEntryText(entry));
        }

        var line = string.Join(" ", parts);
        if (string.IsNullOrEmpty(line))
        {
            return;
        }

        try
        {
            var copied = await _jsModule.InvokeAsync<bool>("copyTextToClipboard", line, true);
            if (copied)
            {
                await ShowCopyToastAsync(entry, "已复制该条");
            }
        }
        catch (JSDisconnectedException)
        {
            // 页面断开时忽略脚本调用异常。
        }
    }

    private async Task ShowCopyToastAsync(TerminalEntry entry, string text)
    {
        var version = ++_copyToastVersion;
        _copiedEntry = entry;
        _copyToastText = text;
        StateHasChanged();

        await Task.Delay(320);
        if (!_disposed && _copyToastVersion == version)
        {
            _copiedEntry = null;
            StateHasChanged();
        }

        await Task.Delay(980);
        if (!_disposed && _copyToastVersion == version)
        {
            _copyToastText = null;
            StateHasChanged();
        }
    }

    private void SelectMode(DeviceMode mode)
    {
        if (_isConnectedOrBusy || _mode == mode)
        {
            return;
        }

        _mode = mode;
        _connectionError = null;
        if (mode == DeviceMode.Serial)
        {
            RefreshPorts();
        }
    }

    private void RefreshPorts()
    {
        try
        {
            _availablePorts = SerialPortDevice.GetAvailablePorts()
                .OrderBy(p => p, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            if (_availablePorts.Length == 0)
            {
                _selectedPort = string.Empty;
            }
            else if (!_availablePorts.Contains(_selectedPort, StringComparer.OrdinalIgnoreCase))
            {
                _selectedPort = _availablePorts[0];
            }
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "枚举本机串口列表失败");
            _availablePorts = [];
            _selectedPort = string.Empty;
            _connectionError = "枚举串口列表失败，请检查系统串口驱动。";
        }
    }

    private string GetConnectButtonText()
    {
        if (_isChanging)
        {
            return _device is null ? "连接中…" : "关闭中…";
        }

        if (_mode == DeviceMode.VirtualMcu)
        {
            return _device is null ? "启动虚拟设备" : "停止虚拟设备";
        }

        return _device is null ? "打开串口" : "关闭串口";
    }

    private Task ToggleConnectionAsync()
    {
        if (_disposed || _isChanging)
        {
            return Task.CompletedTask;
        }

        _transition = ChangeSessionAsync();
        return _transition;
    }

    private async Task ChangeSessionAsync()
    {
        _isChanging = true;
        _connectionError = null;

        try
        {
            if (_device is null)
            {
                _status = "正在连接…";
                _sendError = null;
                await StartSessionAsync();
            }
            else
            {
                _status = "正在断开…";
                await StopSessionAsync();
                _status = "已断开";
            }
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "切换设备连接状态失败");
            _connectionError = error.Message;
            _status = "连接失败";
        }
        finally
        {
            _isChanging = false;
        }
    }

    private async Task StartSessionAsync()
    {
        var bus = new RawDataBus();
        ICommunicationDevice device;

        if (_mode == DeviceMode.Serial)
        {
            if (string.IsNullOrWhiteSpace(_selectedPort))
            {
                await bus.DisposeAsync();
                throw new InvalidOperationException("请先选择一个可用的串口。");
            }

            if (!int.TryParse(_baudRateText.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var baudRate)
                || baudRate <= 0)
            {
                await bus.DisposeAsync();
                throw new InvalidOperationException("波特率必须是大于 0 的整数。");
            }

            var config = Settings.CreateSerialConfig(_selectedPort, baudRate);
            var serialDevice = new SerialPortDevice(bus, config);
            serialDevice.Faulted += HandleSerialFaulted;
            device = serialDevice;

            // 记住本次连接使用的串口与波特率，方便下次打开自动预选。
            if (!string.Equals(Settings.Serial.LastPortName, _selectedPort, StringComparison.OrdinalIgnoreCase)
                || Settings.Serial.DefaultBaudRate != baudRate)
            {
                Settings.Serial.LastPortName = _selectedPort;
                Settings.Serial.DefaultBaudRate = baudRate;
                Settings.NotifyChanged();
            }
        }
        else
        {
            device = new VirtualMcuDevice(bus);
        }

        _bus = bus;
        _device = device;

        try
        {
            if (Settings.Serial.AutoSaveSerialLogOnOpen)
            {
                // 作为独立订阅者挂到 RawDataBus 上，按当前列设置异步写盘，不阻塞界面与串口收发。
                _logRecorder = new SerialLogRecorder(
                    bus,
                    device.Id,
                    Settings.Serial.SerialLogDirectory,
                    device.Name,
                    () => Settings.CreateSerialLogOptions());
            }

            bus.Subscribe(
                new(device.Id, Capacity: Math.Max(Settings.Serial.MaxDisplayLines, 256), OverflowPolicy: RawDataOverflowPolicy.DropOldest),
                (packet, _) => OnPacketReceivedAsync(bus, packet));

            await device.OpenAsync();
            _status = _mode == DeviceMode.Serial
                ? $"已连接 {_selectedPort} · {_baudRateText.Trim()} bps"
                : "虚拟 MCU 运行中";
        }
        catch
        {
            await StopSessionAsync();
            throw;
        }
    }

    private void HandleSerialFaulted(object? sender, Exception error)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed || !ReferenceEquals(_device, sender))
            {
                return;
            }

            AppendSystemEntry($"串口发生故障已断开：{error.Message}");
            _connectionError = $"串口异常断开：{error.Message}";
            await StopSessionAsync();
            _status = "异常断开";
            RefreshPorts();
            StateHasChanged();
        });
    }

    private async Task StopSessionAsync()
    {
        var device = _device;
        var recorder = _logRecorder;
        var bus = _bus;

        _device = null;
        _logRecorder = null;
        _bus = null;
        _isVirtualAutoSending = false;

        if (device is SerialPortDevice serialDevice)
        {
            serialDevice.Faulted -= HandleSerialFaulted;
        }

        try
        {
            if (device is not null)
            {
                await device.DisposeAsync();
            }
        }
        finally
        {
            try
            {
                // 先释放总线以排空总线上尚未分发给订阅者的尾包，确保日志记录器全部写完。
                if (bus is not null)
                {
                    await bus.DisposeAsync();
                }
            }
            finally
            {
                if (recorder is not null)
                {
                    await recorder.DisposeAsync();
                }
            }
        }
    }

    private Task StartVirtualAutoAsync()
    {
        if (_virtualIntervalMs <= 0)
        {
            _connectionError = "虚拟设备发送周期必须大于 0 毫秒。";
            return Task.CompletedTask;
        }

        return SetVirtualAutoAsync(true, (uint)_virtualIntervalMs);
    }

    private Task StopVirtualAutoAsync() => SetVirtualAutoAsync(false, 1000u);

    private async Task SetVirtualAutoAsync(bool enabled, uint intervalMs)
    {
        if (_device is not VirtualMcuDevice virtualDevice || !CanControlVirtualAuto)
        {
            return;
        }

        _isTogglingVirtualAuto = true;
        _connectionError = null;

        try
        {
            await virtualDevice.AutoSendAsync(enabled, intervalMs);
            if (!_disposed && ReferenceEquals(_device, virtualDevice))
            {
                _isVirtualAutoSending = enabled;
            }
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "切换虚拟设备自动发送失败");
            if (!_disposed && ReferenceEquals(_device, virtualDevice))
            {
                _connectionError = error.Message;
            }
        }
        finally
        {
            _isTogglingVirtualAuto = false;
        }
    }

    private async Task SendAsync()
    {
        var device = _device;
        if (device is null || !CanSend)
        {
            return;
        }

        byte[] payload;
        if (Settings.Serial.SendAsHex)
        {
            var normalizedHex = _draft.Replace("\r", " ", StringComparison.Ordinal)
                                      .Replace("\n", " ", StringComparison.Ordinal);
            if (!DataHelper.TryParseHex(normalizedHex, out var hexBytes, out var hexError))
            {
                _sendError = hexError;
                return;
            }

            payload = AppendLineEndings(hexBytes);
        }
        else
        {
            payload = AppendLineEndings(Encoding.UTF8.GetBytes(_draft));
        }

        _isSending = true;
        _sendError = null;

        try
        {
            await device.SendAsync(payload);
        }
        catch (OperationCanceledException) when (!ReferenceEquals(_device, device))
        {
            // 断开旧会话导致的取消属于预期行为。
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "发送数据失败");
            if (!_disposed && ReferenceEquals(_device, device))
            {
                _sendError = $"发送失败：{error.Message}";
            }
        }
        finally
        {
            _isSending = false;
        }
    }

    private byte[] AppendLineEndings(byte[] raw)
    {
        var extra = (Settings.Serial.AppendCr ? 1 : 0) + (Settings.Serial.AppendLf ? 1 : 0);
        if (extra == 0)
        {
            return raw;
        }

        var result = new byte[raw.Length + extra];
        Buffer.BlockCopy(raw, 0, result, 0, raw.Length);
        var offset = raw.Length;
        if (Settings.Serial.AppendCr)
        {
            result[offset++] = 0x0D;
        }

        if (Settings.Serial.AppendLf)
        {
            result[offset] = 0x0A;
        }

        return result;
    }

    private ValueTask OnPacketReceivedAsync(RawDataBus bus, RawDataPacket packet)
    {
        var payloadCopy = packet.Payload.ToArray();
        var timestamp = DateTimeOffset.FromUnixTimeMilliseconds(packet.TimestampMs);
        var dir = packet.Direction == PacketDirection.Tx ? "TX" : "RX";

        return new ValueTask(InvokeAsync(() =>
        {
            if (_disposed || !ReferenceEquals(_bus, bus))
            {
                return;
            }

            if (packet.Direction == PacketDirection.Tx)
            {
                _txBytes += payloadCopy.Length;
            }
            else
            {
                _rxBytes += payloadCopy.Length;
            }

            _entries.Add(new TerminalEntry(timestamp, dir, packet.SeqNo, payloadCopy));
            TrimEntriesToLimit();

            if (Settings.Serial.AutoScroll && !_userScrolledUp)
            {
                _pendingScrollToBottom = true;
            }

            StateHasChanged();
        }));
    }

    private void AppendSystemEntry(string message)
    {
        _entries.Add(new TerminalEntry(DateTimeOffset.Now, "SYS", null, [], message));
        TrimEntriesToLimit();
        if (Settings.Serial.AutoScroll && !_userScrolledUp)
        {
            _pendingScrollToBottom = true;
        }
    }

    private void TrimEntriesToLimit()
    {
        var limit = Math.Max(Settings.Serial.MaxDisplayLines, 50);
        if (_entries.Count > limit)
        {
            _entries.RemoveRange(0, _entries.Count - limit);
        }
    }

    private void ClearEntries()
    {
        _entries.Clear();
        _rxBytes = 0;
        _txBytes = 0;
        _userScrolledUp = false;
    }

    private void SetDisplayMode(TerminalDisplayMode mode)
    {
        if (Settings.Serial.DisplayMode != mode)
        {
            Settings.Serial.DisplayMode = mode;
            Settings.NotifyChanged();
        }
    }

    private void ToggleAutoScroll()
    {
        Settings.Serial.AutoScroll = !Settings.Serial.AutoScroll;
        if (Settings.Serial.AutoScroll)
        {
            _userScrolledUp = false;
            _pendingScrollToBottom = true;
        }

        Settings.NotifyChanged();
    }

    private async Task JumpToBottomAsync()
    {
        _userScrolledUp = false;
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("scrollToBottom", _outputRef);
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时忽略脚本调用异常。
            }
        }
    }

    private void OnFontSizeInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var size))
        {
            Settings.SetFontSize(size);
        }
    }

    private void ToggleSetting(Action mutation)
    {
        mutation();
        _sendError = null;
        Settings.NotifyChanged();
    }

    private async Task PickSerialLogFolderAsync()
    {
        if (_isPickingFolder || !FolderPicker.IsSupported)
        {
            return;
        }

        _isPickingFolder = true;
        try
        {
            var selected = await FolderPicker.PickFolderAsync("选择串口收发日志保存目录", Settings.Serial.SerialLogDirectory);
            if (!string.IsNullOrWhiteSpace(selected))
            {
                Settings.Serial.SerialLogDirectory = selected;
                Settings.NotifyChanged();
            }
        }
        finally
        {
            _isPickingFolder = false;
        }
    }

    private void OnDefaultBaudChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var baud) && baud > 0)
        {
            Settings.Serial.DefaultBaudRate = baud;
            if (_device is null)
            {
                _baudRateText = baud.ToString(CultureInfo.InvariantCulture);
            }
            Settings.NotifyChanged();
        }
    }

    private void OnDataBitsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var bits))
        {
            Settings.Serial.DataBits = bits;
            Settings.NotifyChanged();
        }
    }

    private void OnStopBitsChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<StopBits>(e.Value?.ToString(), out var stopBits))
        {
            Settings.Serial.StopBits = stopBits;
            Settings.NotifyChanged();
        }
    }

    private void OnParityChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Parity>(e.Value?.ToString(), out var parity))
        {
            Settings.Serial.Parity = parity;
            Settings.NotifyChanged();
        }
    }

    private void OnFlowControlChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Handshake>(e.Value?.ToString(), out var handshake))
        {
            Settings.Serial.FlowControl = handshake;
            Settings.NotifyChanged();
        }
    }

    private void OnMaxLinesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var maxLines))
        {
            Settings.Serial.MaxDisplayLines = maxLines;
            Settings.NotifyChanged();
        }
    }

    private void OnSerialLogFormatChanged(ChangeEventArgs e)
    {
        var format = e.Value?.ToString();
        if (format is ".log" or ".bin")
        {
            Settings.Serial.SerialLogFormat = format;
            Settings.NotifyChanged();
        }
    }

    private async Task OnAutoSaveSerialLogChangedAsync(ChangeEventArgs e)
    {
        if (e.Value is not bool enabled)
        {
            return;
        }

        Settings.Serial.AutoSaveSerialLogOnOpen = enabled;
        Settings.NotifyChanged();

        // 如果设备已经打开，切换开关时立即生效，无需断开重连。
        var bus = _bus;
        var device = _device;
        if (bus is null || device is null || !device.IsOpen)
        {
            return;
        }

        if (enabled && _logRecorder is null)
        {
            try
            {
                _logRecorder = new SerialLogRecorder(
                    bus,
                    device.Id,
                    Settings.Serial.SerialLogDirectory,
                    device.Name,
                    () => Settings.CreateSerialLogOptions());
            }
            catch (Exception error)
            {
                Serilog.Log.Error(error, "动态开启串口日志记录失败");
                _connectionError = $"开启串口日志失败：{error.Message}";
            }
        }
        else if (!enabled && _logRecorder is not null)
        {
            var recorder = _logRecorder;
            _logRecorder = null;
            try
            {
                await recorder.DisposeAsync();
            }
            catch (Exception error)
            {
                Serilog.Log.Warning(error, "停止串口日志记录失败");
            }
        }
    }

    private void UpdateBool(Action<bool> setter, ChangeEventArgs e)
    {
        if (e.Value is bool value)
        {
            setter(value);
            Settings.NotifyChanged();
        }
    }

    private string FormatEntryText(TerminalEntry entry)
    {
        if (entry.SystemMessage is not null)
        {
            return entry.SystemMessage;
        }

        if (entry.Payload.Length == 0)
        {
            return "(空)";
        }

        return Settings.Serial.DisplayMode == TerminalDisplayMode.Hex
            ? BitConverter.ToString(entry.Payload).Replace("-", " ", StringComparison.Ordinal)
            : Encoding.UTF8.GetString(entry.Payload);
    }

    private static string GetRowCssClass(TerminalEntry entry) => entry.Direction switch
    {
        "TX" => "is-tx",
        "SYS" => "is-sys",
        _ => "is-rx"
    };

    private static string GetDirCssClass(TerminalEntry entry) => entry.Direction switch
    {
        "TX" => "ls-dir-tx",
        "SYS" => "ls-dir-sys",
        _ => "ls-dir-rx"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Settings.Changed -= HandleSettingsChanged;

        try
        {
            if (_transition is not null)
            {
                await _transition;
            }
        }
        finally
        {
            await StopSessionAsync();
        }

        foreach (var handle in new[] { _scrollWatcher, _sendKeyHandler })
        {
            if (handle is not null)
            {
                try
                {
                    await handle.InvokeVoidAsync("dispose");
                    await handle.DisposeAsync();
                }
                catch (JSDisconnectedException)
                {
                    // 页面断开时无需释放前端监听器。
                }
            }
        }

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时无需释放前端模块。
            }
        }

        _dotNetRef?.Dispose();
    }
}
