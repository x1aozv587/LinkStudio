    private async Task OnAutoSaveSerialLogChangedAsync(ChangeEventArgs e)
    {
        if (e.Value is not bool enabled)
        {
            return;
        }

        Settings.Serial.AutoSaveSerialLogOnOpen = enabled;
        Settings.NotifyChanged();

        // 如果设备已经打开，切换开关时立即生效，无需断开重连。
        var bus = _bus;
        var device = _device;
        if (bus is null || device is null || !device.IsOpen)
        {
            return;
        }

        if (enabled && _logRecorder is null)
        {
            try
            {
                _logRecorder = new SerialLogRecorder(
                    bus,
                    device.Id,
                    Settings.Serial.SerialLogDirectory,
                    device.Name,
                    () => Settings.CreateSerialLogOptions());
            }
            catch (Exception error)
            {
                Serilog.Log.Error(error, "动态开启串口日志记录失败");
                _connectionError = $"开启串口日志失败：{error.Message}";
            }
        }
        else if (!enabled && _logRecorder is not null)
        {
            var recorder = _logRecorder;
            _logRecorder = null;
            try
            {
                await recorder.DisposeAsync();
            }
            catch (Exception error)
            {
                Serilog.Log.Warning(error, "停止串口日志记录失败");
            }
        }
    }

    private void UpdateBool(Action<bool> setter, ChangeEventArgs e)
    {
        if (e.Value is bool value)
        {
            setter(value);
            Settings.NotifyChanged();
        }
    }

    private RenderFragment RenderHighlightedText(string text) => builder =>
    {
        var compiled = SessionHub.CompiledRules;
        if (compiled.Count == 0 || string.IsNullOrEmpty(text))
        {
            builder.AddContent(0, text);
            return;
        }

        var segments = TerminalFilterEngine.BuildSegments(text, compiled);
        var seq = 0;
        foreach (var segment in segments)
        {
            if (segment.ColorKey is null)
            {
                builder.AddContent(seq++, segment.Text);
            }
            else
            {
                builder.OpenElement(seq++, "mark");
                builder.AddAttribute(seq++, "class", $"ls-hl ls-hl-{segment.ColorKey}");
                builder.AddContent(seq++, segment.Text);
                builder.CloseElement();
            }
        }
    };

    private string FormatEntryText(TerminalLogEntry entry) =>
        TerminalSessionHub.FormatEntryText(entry, Settings.Serial.DisplayMode);

    private static string GetRowCssClass(TerminalLogEntry entry) => entry.Direction switch
    {
        "TX" => "is-tx",
        "SYS" => "is-sys",
        _ => "is-rx"
    };

    private static string GetDirCssClass(TerminalLogEntry entry) => entry.Direction switch
    {
        "TX" => "ls-dir-tx",
        "SYS" => "ls-dir-sys",
        _ => "ls-dir-rx"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _uiRefreshThrottleTimer?.Dispose();
        Settings.Changed -= HandleSettingsChanged;
        SessionHub.RulesChanged -= HandleFilterRulesChanged;
        SessionHub.JumpToEntryRequested -= HandleJumpToEntryRequested;
        DeviceChangeMonitor.DevicesChanged -= HandleHardwareDevicesChanged;

        try
        {
            if (_transition is not null)
            {
                await _transition;
            }
        }
        finally
        {
            await StopSessionAsync();
        }

        foreach (var handle in new[] { _scrollWatcher, _sendKeyHandler })
        {
            if (handle is not null)
            {
                try
                {
                    await handle.InvokeVoidAsync("dispose");
                    await handle.DisposeAsync();
                }
                catch (JSDisconnectedException)
                {
                    // 页面断开时无需释放前端监听器。
                }
            }
        }

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时无需释放前端模块。
            }
        }

        _dotNetRef?.Dispose();
    }
