    private async Task OnVirtualSimModeChangedAsync(VirtualMcuSimulationMode mode)
    {
        _virtualSimMode = mode;
        if (_device is VirtualMcuDevice virtualDevice && !_disposed)
        {
            try
            {
                await virtualDevice.SetSimulationModeAsync(mode);
            }
            catch (Exception error)
            {
                Serilog.Log.Error(error, "切换虚拟 MCU 模拟模式失败");
                _connectionError = error.Message;
            }
        }
    }

    private Task StartVirtualAutoAsync()
    {
        if (_virtualIntervalMs <= 0)
        {
            _connectionError = "虚拟设备发送周期必须大于 0 毫秒。";
            return Task.CompletedTask;
        }

        return SetVirtualAutoAsync(true, (uint)_virtualIntervalMs);
    }

    private Task StopVirtualAutoAsync() => SetVirtualAutoAsync(false, 1000u);

    private async Task SetVirtualAutoAsync(bool enabled, uint intervalMs)
    {
        if (_device is not VirtualMcuDevice virtualDevice || !CanControlVirtualAuto)
        {
            return;
        }

        _isTogglingVirtualAuto = true;
        _connectionError = null;

        try
        {
            await virtualDevice.AutoSendAsync(enabled, intervalMs);
            if (!_disposed && ReferenceEquals(_device, virtualDevice))
            {
                _isVirtualAutoSending = enabled;
            }
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "切换虚拟设备自动发送失败");
            if (!_disposed && ReferenceEquals(_device, virtualDevice))
            {
                _connectionError = error.Message;
            }
        }
        finally
        {
            _isTogglingVirtualAuto = false;
        }
    }

    private async Task SendAsync()
    {
        var device = _device;
        if (device is null || !CanSend)
        {
            return;
        }

        byte[] payload;
        if (Settings.Serial.SendAsHex)
        {
            var normalizedHex = _draft.Replace("\r", " ", StringComparison.Ordinal)
                                      .Replace("\n", " ", StringComparison.Ordinal);
            if (!DataHelper.TryParseHex(normalizedHex, out var hexBytes, out var hexError))
            {
                _sendError = hexError;
                return;
            }

            payload = AppendLineEndings(hexBytes);
        }
        else
        {
            payload = AppendLineEndings(Encoding.UTF8.GetBytes(_draft));
        }

        _isSending = true;
        _sendError = null;

        try
        {
            await device.SendAsync(payload);
        }
        catch (OperationCanceledException) when (!ReferenceEquals(_device, device))
        {
            // 断开旧会话导致的取消属于预期行为。
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "发送数据失败");
            if (!_disposed && ReferenceEquals(_device, device))
            {
                _sendError = $"发送失败：{error.Message}";
            }
        }
        finally
        {
            _isSending = false;
        }
    }

    private byte[] AppendLineEndings(byte[] raw)
    {
        var extra = (Settings.Serial.AppendCr ? 1 : 0) + (Settings.Serial.AppendLf ? 1 : 0);
        if (extra == 0)
        {
            return raw;
        }

        var result = new byte[raw.Length + extra];
        Buffer.BlockCopy(raw, 0, result, 0, raw.Length);
        var offset = raw.Length;
        if (Settings.Serial.AppendCr)
        {
            result[offset++] = 0x0D;
        }

        if (Settings.Serial.AppendLf)
        {
            result[offset] = 0x0A;
        }

        return result;
    }

    private ValueTask OnPacketReceivedAsync(RawDataBus bus, RawDataPacket packet)
    {
        if (_disposed || !ReferenceEquals(_bus, bus))
        {
            return ValueTask.CompletedTask;
        }

        var payloadCopy = packet.Payload.ToArray();
        var timestamp = DateTimeOffset.FromUnixTimeMilliseconds(packet.TimestampMs);
        var dir = packet.Direction == PacketDirection.Tx ? "TX" : "RX";

        if (packet.Direction == PacketDirection.Tx)
        {
            Interlocked.Add(ref _txBytes, payloadCopy.Length);
        }
        else
        {
            Interlocked.Add(ref _rxBytes, payloadCopy.Length);
        }

        // 在后台总线线程直接入库（多行拆包合并为一次通知），避免每包阻塞在 UI 线程渲染上。
        if (Settings.Serial.SplitByNewLine
            && packet.Direction == PacketDirection.Rx
            && Settings.Serial.DisplayMode == TerminalDisplayMode.Utf8
            && payloadCopy.Length > 0)
        {
            var lines = DataHelper.SplitByteLines(payloadCopy);
            if (lines.Count > 0)
            {
                var batch = new TerminalLogEntry[lines.Count];
                for (var i = 0; i < lines.Count; i++)
                {
                    batch[i] = new TerminalLogEntry(SessionHub.NextEntryId(), timestamp, dir, packet.SeqNo, lines[i]);
                }

                SessionHub.AddEntries(batch, Settings.Serial.MaxDisplayLines, preserveTop: _userScrolledUp);
            }
        }
        else
        {
            SessionHub.AddEntry(
                new TerminalLogEntry(SessionHub.NextEntryId(), timestamp, dir, packet.SeqNo, payloadCopy),
                Settings.Serial.MaxDisplayLines,
                preserveTop: _userScrolledUp);
        }

        // 终端处于隐藏态（用户正在看协议/可视化/自定义画板）时跳过重绘，彻底消除后台无效 DOM 刷新。
        if (IsVisible && Interlocked.CompareExchange(ref _uiRefreshScheduled, 1, 0) == 0)
        {
            _uiRefreshThrottleTimer?.Change(60, Timeout.Infinite);
        }

        return ValueTask.CompletedTask;
    }

    private void OnUiRefreshThrottleElapsed(object? state)
    {
        Interlocked.Exchange(ref _uiRefreshScheduled, 0);
        if (_disposed || !IsVisible)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_disposed || !IsVisible)
            {
                return;
            }

            _entries = SessionHub.GetEntriesSnapshot();
            if (Settings.Serial.AutoScroll && !_userScrolledUp)
            {
                _pendingScrollToBottom = true;
            }

            StateHasChanged();
        });
    }

    private void AppendSystemEntry(string message)
    {
        SessionHub.AddEntry(
            new TerminalLogEntry(SessionHub.NextEntryId(), DateTimeOffset.Now, "SYS", null, [], message),
            Settings.Serial.MaxDisplayLines);
        _entries = SessionHub.GetEntriesSnapshot();
        if (Settings.Serial.AutoScroll && !_userScrolledUp)
        {
            _pendingScrollToBottom = true;
        }
    }

    private void TrimEntriesToLimit()
    {
        SessionHub.TrimEntries(Settings.Serial.MaxDisplayLines);
        _entries = SessionHub.GetEntriesSnapshot();
    }

    private void ClearEntries()
    {
        SessionHub.ClearEntries();
        _entries = [];
        _rxBytes = 0;
        _txBytes = 0;
        _userScrolledUp = false;
    }

    private void SetDisplayMode(TerminalDisplayMode mode)
    {
        if (Settings.Serial.DisplayMode != mode)
        {
            Settings.Serial.DisplayMode = mode;
            Settings.NotifyChanged();
        }
    }

    private void ToggleAutoScroll()
    {
        Settings.Serial.AutoScroll = !Settings.Serial.AutoScroll;
        if (Settings.Serial.AutoScroll)
        {
            _userScrolledUp = false;
            _pendingScrollToBottom = true;
        }

        Settings.NotifyChanged();
    }

    private async Task JumpToBottomAsync()
    {
        _userScrolledUp = false;
        _pendingScrollToBottom = true;
        TrimEntriesToLimit();
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("scrollToBottom", _outputRef, true);
            }
            catch (JSDisconnectedException)
            {
                // 页面断开时忽略脚本调用异常。
            }
        }
    }

