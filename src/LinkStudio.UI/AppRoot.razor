@using LinkStudio.Core.Services
@using LinkStudio.Core.Services.Interfaces
@implements IAsyncDisposable

<div class="ls-app-shell" data-theme="@_settings.GetThemeKey()">
    <!-- 最左侧极简导航：顶部是工作区入口，左下角是全局设置 -->
    <aside class="ls-activity-rail" aria-label="主导航">
        <div class="ls-rail-top">
            <div class="ls-brand-mark" title="LinkStudio">LS</div>

            <button type="button"
                    class="ls-rail-btn @(_activePage == AppPage.Terminal ? "is-active" : string.Empty)"
                    title="串口终端"
                    aria-label="串口终端"
                    @onclick="() => _activePage = AppPage.Terminal">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="4 17 10 11 4 5" />
                    <line x1="12" y1="19" x2="20" y2="19" />
                </svg>
                <span class="ls-rail-label">终端</span>
            </button>

            <button type="button"
                    class="ls-rail-btn @(_activePage == AppPage.Protocol ? "is-active" : string.Empty)"
                    title="协议监视（NMEA / JSON 结构化解析）"
                    aria-label="协议监视"
                    @onclick="() => _activePage = AppPage.Protocol">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                </svg>
                <span class="ls-rail-label">协议</span>
            </button>

            <button type="button"
                    class="ls-rail-btn @(_activePage == AppPage.Dashboard ? "is-active" : string.Empty)"
                    title="可视化仪表盘（波形图 / KPI / 天空图 / SNR）"
                    aria-label="可视化"
                    @onclick="() => _activePage = AppPage.Dashboard">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="9" rx="1.5" />
                    <rect x="14" y="3" width="7" height="5" rx="1.5" />
                    <rect x="14" y="12" width="7" height="9" rx="1.5" />
                    <rect x="3" y="16" width="7" height="5" rx="1.5" />
                </svg>
                <span class="ls-rail-label">可视化</span>
            </button>
        </div>

        <div class="ls-rail-bottom">
            <button type="button"
                    class="ls-rail-btn @(_activePage == AppPage.Settings ? "is-active" : string.Empty)"
                    title="全局设置"
                    aria-label="全局设置"
                    @onclick="() => _activePage = AppPage.Settings">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.85 1 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
                <span class="ls-rail-label">设置</span>
            </button>
        </div>
    </aside>

    <!-- 主内容舞台：终端保持挂载，切到设置页时不断开串口、不丢历史日志 -->
    <main class="ls-stage">
        <div class="ls-pane @(_activePage == AppPage.Terminal ? string.Empty : "ls-pane-hidden")">
            <TerminalView Settings="_settings" />
        </div>

        @if (_activePage == AppPage.Protocol)
        {
            <div class="ls-pane">
                <ProtocolView />
            </div>
        }

        @if (_activePage == AppPage.Dashboard)
        {
            <div class="ls-pane">
                <DashboardView />
            </div>
        }

        @if (_activePage == AppPage.Settings)
        {
            <div class="ls-pane">
                <SettingsView Settings="_settings" />
            </div>
        }
    </main>
</div>

@code {
    private enum AppPage
    {
        Terminal,
        Protocol,
        Dashboard,
        Settings
    }

    [Inject]
    private IAppsSettingsService SettingsService { get; set; } = default!;

    [Inject]
    private WorkbenchSettings _settings { get; set; } = default!;

    private AppPage _activePage = AppPage.Terminal;
    private CancellationTokenSource? _saveDebounceCts;
    private bool _lastAppLogEnabled;
    private string _lastAppLogDir = string.Empty;
    private bool _settingsLoaded;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _settings.Changed += HandleSettingsChanged;

        try
        {
            var loaded = await SettingsService.LoadSettingsAsync();
            _settings.ApplyFrom(loaded);
        }
        catch (Exception error)
        {
            Serilog.Log.Warning(error, "加载本地配置失败，已使用默认配置");
        }

        _settingsLoaded = true;
        ApplyAppLoggingIfChanged(force: true);
        _settings.NotifyChanged();
    }

    private void HandleSettingsChanged()
    {
        if (_disposed)
        {
            return;
        }

        if (_settingsLoaded)
        {
            ApplyAppLoggingIfChanged(force: false);
            ScheduleSaveSettings();
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyAppLoggingIfChanged(bool force)
    {
        var enabled = _settings.Studio.AutoSaveAppLogOnStartup;
        var dir = _settings.Studio.AppLogDirectory;
        if (!force && enabled == _lastAppLogEnabled && string.Equals(dir, _lastAppLogDir, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppLogEnabled = enabled;
        _lastAppLogDir = dir;
        AppLogging.Configure(enabled, dir);
    }

    private void ScheduleSaveSettings()
    {
        // 防抖保存：滑动字号滑块等高频变更时合并为最后一次写盘，避免频繁 I/O。
        _saveDebounceCts?.Cancel();
        _saveDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _saveDebounceCts = cts;

        _ = SaveAfterDelayAsync(cts.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct);
            await SettingsService.SaveSettingsAsync(_settings.ToAppsSettings(), ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // 被更新的保存请求取代属于预期行为。
        }
        catch (Exception error)
        {
            Serilog.Log.Error(error, "保存配置文件失败");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _settings.Changed -= HandleSettingsChanged;
        _saveDebounceCts?.Cancel();
        _saveDebounceCts?.Dispose();

        if (_settingsLoaded)
        {
            try
            {
                await SettingsService.SaveSettingsAsync(_settings.ToAppsSettings());
            }
            catch (Exception error)
            {
                Serilog.Log.Warning(error, "退出时保存配置失败");
            }
        }
    }
}
